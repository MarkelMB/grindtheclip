", "caption": "Me quedas tú. Una gran fiesta para un héroe americano, mi hijo, el astronauta.", "start": 22.35, "end": 27.76, "confidence": 0.95}, {"id": "b9127517-8f8d-4ba8-932c-38f4f99ad95f", "character": "Peter Parker", "caption": "Pero, ¿podría pagarme por adelantado?", "start": 26.54, "end": 29.56, "confidence": 0.95}, {"id": "3a84bc1f-8c14-46d6-9074-1e14004f6f67", "character": "J. Jonah Jameson", "caption": "[risas]", "start": 28.0, "end": 31.36, "confidence": 0.98}, {"id": "64a48034-69aa-45a2-b862-383e805ededf", "character": "J. Jonah Jameson", "caption": "¿Por qué? ¿Por estar plantado?", "start": 36.38, "end": 38.95, "confidence": 0.95}, {"id": "6a7d5974-5bd8-4419-9b16-6531b51d55a2", "character": "J. Jonah Jameson", "caption": "En el planetario mañana a las 20 horas.", "start": 39.55, "end": 42.64, "confidence": 0.95}, {"id": "0eb5bc6f-1fd1-40f0-b50b-a6662ea57740", "character": "J. Jonah Jameson", "caption": "¡Fuera!", "start": 41.7, "end": 42.64, "confidence": 0.95}], "characters": [{"name": "Betty Brant", "color": "#22d3ee"}, {"name": "J. Jonah Jameson", "color": "#e5636b"}, {"name": "Peter Parker", "color": "#4caf7d"}, {"name": "Robbie Robertson", "color": "#d9a441"}], "video_url": "/uploads/502ce03c-6da9-4a71-a613-256972ee59cb/yt_video.mp4", "updated_at": 1788031096.6710446}