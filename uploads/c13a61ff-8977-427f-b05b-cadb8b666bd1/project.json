{"job_id": "c13a61ff-8977-427f-b05b-cadb8b666bd1", "pack_name": "lobesno v2", "lines": [{"id": "cdbd67d9-8faa-444a-a379-9e4e34e242f6", "character": "William Stryker", "caption": "Hagámoslo.", "start": 0.0, "end": 3.55}, {"id": "bdd97934-2fd2-4455-82bc-33dfbd0fdf55", "character": "William Stryker", "caption": "Casi se me olvida.", "start": 3.35, "end": 7.15}, {"id": "264a9c37-6c1d-4817-856f-510a3ab88e20", "character": "Wolverine", "caption": "Quiero unas nuevas.", "start": 8.15, "end": 11.05}, {"id": "6bb4dae9-21e3-4e0b-a748-8471c1ad85cd", "character": "William Stryker", "caption": "¿Y qué nombre llevarán?", "start": 10.55, "end": 13.85}, {"id": "4e0d7d4d-3c81-4071-8091-ef19ff241fd1", "character": "Wolverine", "caption": "Lobezno.", "start": 13.85, "end": 16.35}, {"id": "08a27a86-8537-4f3c-bb85-48b3a71d7d2c", "character": "General Munson", "caption": "Hoy seremos testigos de la historia médica. Hoy vamos a crear el Arma X.", "start": 19.45, "end": 25.35}, {"id": "709cf2df-011a-4d7a-a334-a94f8fcc3fe5", "character": "Agent Zero", "caption": "¿X?", "start": 24.95, "end": 26.85}, {"id": "6537d1da-879d-4f44-8962-d3eb32197260", "character": "William Stryker", "caption": "En números romanos, 10.", "start": 26.45, "end": 29.55}, {"id": "c1467e8a-2670-43c0-9011-e4ffe10b433c", "character": "William Stryker", "caption": "Vamos a comenzar a fusionar el Adamantium con el esqueleto del Arma X. Empecemos.", "start": 30.15, "end": 38.15}, {"id": "f58ea25c-0b84-4a0e-9ce4-d5fedb403135", "character": "Doctor", "caption": "Temperatura corporal 42 y medio y subiendo.", "start": 118.45, "end": 121.55}, {"id": "c7c4f9bf-fed5-488f-bd60-a674f035ff3e", "character": "Doctor", "caption": "¿Por qué se revuelve así? ¿Por qué no está sedado?", "start": 123.15, "end": 126.65}, {"id": "d12278de-090a-46cb-a2b3-e41bdab43a8b", "character": "William Stryker", "caption": "Siente dolor igual que cualquiera, pero la anestesia no le hace efecto. Por eso tenía que ser voluntario.", "start": 126.05, "end": 13