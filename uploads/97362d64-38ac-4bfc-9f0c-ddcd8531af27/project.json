{"job_id": "97362d64-38ac-4bfc-9f0c-ddcd8531af27", "pack_name": "gambol", "lines": [{"id": "2e23217d-aa8a-4852-8919-fdb393a4fe1d", "character": "Persona de anuncio", "caption": "Cada jornada es un círculo que se vuelve cuadrado,", "start": 0.39, "end": 3.08, "confidence": 0.95}, {"id": "51fc0fd4-9fef-4721-885d-f32b8686b80e", "character": "Persona de anuncio", "caption": "pero no puedes cuadrar el círculo,", "start": 2.95, "end": 6.23, "confidence": 0.95}, {"id": "674ce773-4a37-452a-aaea-5d30623e94e9", "character": "Persona de anuncio", "caption": "solo puedes correr,", "start": 6.45, "end": 8.17, "confidence": 0.95}, {"id": "64605491-c4ca-4779-894b-0f5da91ac4e3", "character": "Persona de anuncio", "caption": "correr hacia ti,", "start": 8.45, "end": 11.08, "confidence": 0.95}, {"id": "396346eb-0253-46c0-ab59-5788b3c2b520", "character": "Persona de anuncio", "caption": "hacia mí,", "start": 12.13, "end": 13.58, "confidence": 0.95}, {"id": "9e5e4efa-9172-462c-8c89-4c94594263d0", "character": "Persona de anuncio", "caption": "hacia nosotros,", "start": 13.94, "end": 14.84, "confidence": 0.95}, {"id": "d321b111-a89c-4a7c-a7c1-020b68a02432", "character": "Persona de anuncio", "caption": "hacia afuera de todo,", "start": 14.95, "end": 16.93, "confidence": 0.95}, {"id": "b197ee45-c5e8-4b8d-8720-a225e3777d64", "character": "Persona de anuncio", "caption": "adentro de la nada,", "start": 18.45, "end": 19.71, "confidence": 0.95}, {"id": "21c045cf-36a6-4fce-b9d7-76428305ae83", "character": "Persona de anuncio", "caption": "en fin, eternidad o...", "start": 20.95, "end": 23.58, "confidence": 0.95}, {"id": "6f6bafc3-8476-4ac9-bf75-07e4614d1de3", "character": "Persona de anuncio", "caption": "Okay, okay, ¡ya puedes saltar el video! ¡Qué prisa!", "start": 23.45, "end": 26.11, "confidence": 0.95}, {"id": "141fc665-5282-4b17-9224-7d4bfd771573", "character": "Richard Watterson", "caption": "Eh, hola. Esta semana reseñaré un juego que forma parte de mi computadora.", "start": 27.43, "end": 31.44, "confidence": 0.95}, {"id": "84e8e74f-8eca-4ad2-9292-857a92664c0a", "character": "Richard Watterson", "caption": "No es tan bueno como buscaminas o solitario,", "start": 30.95, "end": 34.98, "confidence": 0.95}, {"id": "c22a202f-b55c-4b9c-8199-d9435cd3442c", "character": "Richard Watterson", "caption": "pero vale la pena.", "start": 34.85, "end": 36.58, "confidence": 0.95}, {"id": "3d17aead-e244-4779-8ce9-0b508dd270fc", "character": "Richard Watterson", "caption": "Okay, ahora yo voy a cargar el juego.", "start": 36.45, "end": 39.94, "confidence": 0.95}, {"id": "5293210f-aab5-4dbb-81ce-9c91e5b1a850", "character": "Richard Watterson", "caption": "Bien, se llama calculadora.", "start": 40.72, "end": 43.58, "confidence": 0.95}, {"id": "60f33fdd-3cbd-4706-9c1d-f230e44255b3", "character": "Richard Watterson", "caption": "Eliges a tu personaje y tomas un par de binoculares.", "start": 43.45, "end": 47.58, "confidence": 0.95}, {"id": "ded7421d-01a5-499c-8341-4b56853af59c", "character": "Richard Watterson", "caption": "Tienes que encontrar el tesoro marcado con una X, obviamente.", "start": 47.45, "end": 52.08, "confidence": 0.95}, {"id": "1ded8969-dde4-4d0b-84c2-f82fba7fa1df", "character": "Richard Watterson", "caption": "Pero ten cuidado, porque cuando llegas al tesoro, hay una serpiente.", "start": 51.95, "end": 56.58, "confidence": 0.95}, {"id": "0647cf0d-1497-41e7-9b26-42a91d9ddfb9", "character": "Richard Watterson", "caption": "Pero está bien,", "start": 56.45, "end": 65.41, "confidence": 0.95}, {"id": "789b44d5-38ed-44b4-a457-410a3212f468", "character": "Richard Watterson", "caption": "porque puedes tomar un hacha o un arco y la flecha y matarla.", "start": 65.33, "end": 101.58, "confidence": 0.95}, {"id": "7f24ff84-a760-4983-970e-8fbdde547b0e", "character": "Richard Watterson", "caption": "Luego ve cuánto hiciste. ¡Oigan, tengo un marcador muy alto!", "start": 100.97, "end": 106.08, "confidence": 0.95}, {"id": "fba37c0a-d5b9-45bd-8ba8-7692fc8526e4", "character": "Richard Watterson", "caption": "Una crítica que tengo es que no hay personajes femeninos,", "start": 106.45, "end": 110.08, "confidence": 0.95}, {"id": "35c8d8dc-9792-4715-8fda-2049aef171c4", "character": "Richard Watterson", "caption": "pero no hay masculinos tampoco,", "start": 109.95, "end": 111.98, "confidence": 0.95}, {"id": "dd78bc9c-af15-447d-8da6-c9ecf163c7ee", "character": "Richard Watterson", "caption": "así que está bien.", "start": 111.85, "end": 113.08, "confidence": 0.95}, {"id": "651abcd9-d5d1-4d3d-8bd2-44d983d9690e", "character": "Richard Watterson", "caption": "Hay un par de errores con ciertos comandos, como cuando quieres usar el arco y el globo.", "start": 112.95, "end": 119.78, "confidence": 0.95}, {"id": "054ba855-e569-422f-8b85-604d8a383493", "character": "Richard Watterson", "caption": "Vean lo que pasa.", "start": 119.65, "end": 121.08, "confidence": 0.95}, {"id": "197034a1-7547-4b88-9890-fc426e148230", "character": "Richard Watterson", "caption": "Es un buen juego. 8 de 10, lo jugaría otra vez.", "start": 122.45, "end": 126.08, "confidence": 0.95}, {"id": "bd7cd3af-77d9-4051-af3e-1a615008913e", "character": "Gumball Watterson", "caption": "¡Jajaja! Gorila contra ballena asesina.", "start": 126.95, "end": 129.08, "confidence": 0.95}, {"id": "495e4ae1-9850-48e5-acf5-638b679923a9", "character": "Gumball Watterson", "caption": "¡Agh, engaño!", "start": 132.95, "end": 135.08, "confidence": 0.95}, {"id": "705ea94b-57e9-4bbc-a457-dd3bb64986be", "character": "Tobias Wilson", "caption": "Hola, soy Tobias Wilson, y esta broma se llama...", "start": 135.95, "end": 139.58, "confidence": 0.95}, {"id": "6bacec49-e090-4f4a-a0f2-88443b38411a", "character": "Tobias Wilson", "caption": "...'¡Ya levántate!'", "start": 139.45, "end": 142.08, "confidence": 0.95}, {"id": "fa61a8ca-4243-49d0-92c2-1c6fb8f2257c", "character": "Tobias Wilson", "caption": "¡Gua-ra-ra-ra-ra! ¡Sí!", "start": 141.95, "end": 145.2, "confidence": 0.95}, {"id": "888cb2f3-ef5e-4adf-88b5-4abc0d90a6f2", "character": "Tobias Wilson", "caption": "De acuerdo, son las 5:00 a.m. y mi papá se va a levantar para ir a trabajar,", "start": 144.76, "end": 148.82, "confidence": 0.95}, {"id": "bc3dfba1-c15f-4065-b7b8-21991b95f031", "character": "Tobias Wilson", "caption": "pero puse mi patineta bajando las escaleras.", "start": 148.46, "end": 153.08, "confidence": 0.95}, {"id": "6454f87d-c905-445d-9096-2b66a470fbf0", "character": "Tobias Wilson", "caption": "¡Shh! Vamos a ver qué pasa.", "start": 152.95, "end": 156.08, "confidence": 0.95}, {"id": "75681d8d-a24f-4f19-a7e5-d99067618535", "character": "Harold Wilson", "caption": "¡Ah! Pero qué...", "start": 157.95, "end": 160.03, "confidence": 0.95}, {"id": "ddb0c6ee-0b67-40fe-93a1-9a90166315d0", "character": "Harold Wilson", "caption": "¡Nena, nos están robando! ¡Ah!", "start": 159.45, "end": 161.83, "confidence": 0.95}, {"id": "5980cfbd-d692-4841-b849-70d5fa182a24", "character": "Harold Wilson", "caption": "¡Policía, tenemos un intruso!", "start": 161.95, "end": 164.05, "confidence": 0.95}, {"id": "23ea31ee-caa3-47f5-9af5-5b100134165a", "character": "Harold Wilson", "caption": "¡Sí!", "start": 163.92, "end": 164.35, "confidence": 0.95}, {"id": "692f9742-2cdd-4613-9606-9e80d9414f89", "character": "Harold Wilson", "caption": "¡Está armado, es peligroso!", "start": 164.22, "end": 166.18, "confidence": 0.95}, {"id": "1583ab02-44a6-4deb-b073-6e0dfc71ee0f", "character": "Harold Wilson", "caption": "¡Usa gorra de rapero!", "start": 166.05, "end": 167.61, "confidence": 0.95}, {"id": "662418fc-71ca-4c2e-af3d-6902af4c5aee", "character": "Tobias Wilson", "caption": "¡Soy yo, es una broma!", "start": 167.23, "end": 170.49, "confidence": 0.95}, {"id": "407967b7-b3e7-47b2-a025-61d1bcbbd296", "character": "Tobias Wilson", "caption": "Cayeron ante Tobias.", "start": 169.87, "end": 172.2, "confidence": 0.95}, {"id": "b97e98de-6c3b-4ef8-ac4f-ef6602901203", "character": "Tobias Wilson", "caption": "¡Jajaja!", "start": 171.8, "end": 173.08, "confidence": 0.95}, {"id": "84db44dd-f82b-4df2-a7bc-1bae1ae64f4d", "character": "Harold Wilson", "caption": "Por supuesto. Pues de repente este horrible acto se vuelve divertido.", "start": 172.95, "end": 177.58, "confidence": 0.95}, {"id": "607be33f-f8ff-4aaf-9372-74c8879b84d1", "character": "Harold Wilson", "caption": "¡Jajaja!", "start": 177.45, "end": 178.19, "confidence": 0.95}, {"id": "09094207-c29a-4684-8e38-e1be266283b8", "character": "Harold Wilson", "caption": "¡Creí que mi familia estaba en peligro mortal, pero no era así!", "start": 178.06, "end": 182.84, "confidence": 0.95}, {"id": "7a5a4e58-9174-427d-ba8b-d7337cb9d23c", "character": "Harold Wilson", "caption": "¡Jajaja!", "start": 182.84, "end": 183.58, "confidence": 0.95}, {"id": "5fdab447-61a0-447b-99f0-99bf2518efb4", "character": "Harold Wilson", "caption": "Estás castigado.", "start": 183.45, "end": 185.08, "confidence": 0.95}, {"id": "742dc88e-b9ab-4e38-87be-23e760b48efa", "character": "Tobias Wilson", "caption": "Agh. Esta fue una broma extrema con Tobias Wils...", "start": 184.66, "end": 189.01, "confidence": 0.95}, {"id": "c91b8744-2cc5-4768-ad1c-f46b8f88375c", "character": "Gumball Watterson", "caption": "¿Qué? ¿El corto de cine de El increíble mundo de Gumball? Dále click.", "start": 190.45, "end": 195.08, "confidence": 0.95}, {"id": "fda0ea79-a863-4d69-9421-467de42de629", "character": "Locutor", "caption": "Este corto ha sido autorizado para todo el público por la Asociación Cinematográfica de Elmore.", "start": 196.45, "end": 200.08, "confidence": 0.95}, {"id": "e6036953-b8b3-4cde-b4da-5ab019437238", "character": "Locutor de video", "caption": "Un pequeño momento de calma.", "start": 204.45, "end": 206.58, "confidence": 0.95}, {"id": "429c0de2-87b6-4336-8570-31cc7a6c745e", "character": "Mr. Small", "caption": "Bienvenidos al pequeño momento de calma conmigo, el Señor Pequeño.", "start": 206.95, "end": 211.08, "confidence": 0.95}, {"id": "46c61bd1-9d1f-42a6-8a72-37984cdcb1d1", "character": "Mr. Small", "caption": "Debí haberlo llamado 'Pequeño momento de calma'. Como sea.", "start": 210.95, "end": 214.03, "confidence": 0.95}, {"id": "f007427f-0cfa-446a-9e60-18cb1db94321", "character": "Mr. Small", "caption": "Disfruten su nuevo cuerpo.", "start": 213.95, "end": 215.03, "confidence": 0.95}, {"id": "592a6f4a-6709-4489-8468-88fb37ed7777", "character": "Mr. Small", "caption": "Liberen sus chakras. Se los demostraré usando mi nuevo disco,", "start": 214.95, "end": 216.46, "confidence": 0.95}, {"id": "ccc3729b-e5ff-4a59-b973-c800a0a2c2c6", "character": "Mr. Small", "caption": "Después de todo, el yoga es renacimiento.", "start": 216.38, "end": 218.03, "confidence": 0.95}, {"id": "e93bf074-778e-4ba9-9bb4-59e3360ae655", "character": "Mr. Small", "caption": "ahora disponible en estaciones de gas y supermercados en rebajas.", "start": 217.58, "end": 220.29, "confidence": 0.95}, {"id": "d4f0f345-9152-4d25-b269-115a3bea4862", "character": "Mr. Small", "caption": "Namasté.", "start": 220.21, "end": 221.09, "confidence": 0.95}, {"id": "4746c7d9-58e2-4662-9b74-d3bd236e2de3", "character": "Gumball Watterson", "caption": "Tengo que blanquearme los ojos después de eso.", "start": 220.95, "end": 223.08, "confidence": 0.95}, {"id": "b6b5c8a5-1505-4b1b-b159-27fc3bdb3fad", "character": "Darwin Watterson", "caption": "Creo que necesitamos algo lindo.", "start": 222.95, "end": 225.45, "confidence": 0.95}, {"id": "a218f558-6502-4cd6-8b32-b56d0ee71a3d", "character": "Mr. Small", "caption": "Abran su pecho y relájense.", "start": 223.95, "end": 227.58, "confidence": 0.95}, {"id": "c46b45d6-d5b5-4518-80e8-58b119cf8b7f", "character": "Mr. Small", "caption": "Inhalen. Exhalen.", "start": 227.95, "end": 231.58, "confidence": 0.95}, {"id": "640b5fcb-8691-4f97-a0e9-37e94e7beb71", "character": "Gumball Watterson", "caption": "¡Oh, vamos!", "start": 228.45, "end": 230.72, "confidence": 0.95}, {"id": "9896354f-ee5d-4bd7-a018-9b8a34bd8a3a", "character": "Gumball Watterson", "caption": "Uh, error épico.", "start": 231.43, "end": 233.34, "confidence": 0.95}, {"id": "69bd3626-411b-42f8-a323-93b9b46f447f", "character": "Mr. Small", "caption": "Inhalen. Exhalen.", "start": 231.95, "end": 235.08, "confidence": 0.95}, {"id": "103485a8-7ee3-4230-b136-c6de81d78b46", "character": "Mr. Small", "caption": "Exhalen.", "start": 235.45, "end": 236.88, "confidence": 0.95}, {"id": "46cadc12-69cc-44ca-b14d-cb8fe7b7e392", "character": "Mr. Small", "caption": "Exhalen.", "start": 236.75, "end": 238.18, "confidence": 0.95}, {"id": "87a8a3bd-cd6d-45f5-86e8-4d0d79a80850", "character": "Hector", "caption": "Jajaja... ¿Vieron eso? Jajaja...", "start": 237.69, "end": 243.56, "confidence": 0.95}, {"id": "5b7c9bf7-52c1-4cd2-8dfa-af9d379c15f8", "character": "Mr. Small", "caption": "Exhalen.", "start": 237.69, "end": 239.48, "confidence": 0.95}, {"id": "a7353255-5f81-4f61-8211-b25c1f15400c", "character": "Mr. Small", "caption": "Exhalen.", "start": 238.92, "end": 240.78, "confidence": 0.95}, {"id": "538cf2ee-ce34-4ce0-8bd6-8edc245281e5", "character": "Mr. Small", "caption": "Exhalen.", "start": 240.65, "end": 242.08, "confidence": 0.95}, {"id": "084e7bb8-24b2-4bf5-896d-2aa4ef0c147c", "character": "Mr. Small", "caption": "Exhalen.", "start": 241.95, "end": 243.56, "confidence": 0.95}, {"id": "d4e3d341-bb01-4e85-92f7-afd1d40f67c9", "character": "Mr. Small", "caption": "Exhalen.", "start": 243.45, "end": 245.08, "confidence": 0.95}, {"id": "4f147c70-cd49-460d-8346-9e1f3fb23058", "character": "Gumball Watterson", "caption": "Es el primero de los que he visto que en verdad es épico. ¿Qué hizo Joe ahora?", "start": 243.95, "end": 248.9, "confidence": 0.95}, {"id": "d53d354f-810c-4223-963f-7ff3badb1164", "character": "Mr. Small", "caption": "Exhalen.", "start": 244.95, "end": 246.91, "confidence": 0.95}, {"id": "5c40ce50-e37c-4fce-bd9a-0c41b4ed59b0", "character": "Mr. Small", "caption": "Exhalen.", "start": 246.45, "end": 248.08, "confidence": 0.95}], "characters": [{