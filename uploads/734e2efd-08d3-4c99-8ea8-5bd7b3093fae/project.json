{"job_id": "734e2efd-08d3-4c99-8ea8-5bd7b3093fae", "pack_name": "lobesno", "lines": [{"character": "Logan", "caption": "Hagámoslo.", "start": 1.45, "end": 3.85, "id": "8bc87433-ea3f-49e7-a31b-f5e6e9f8b5ca"}, {"character": "William Stryker", "caption": "Casi se me olvida.", "start": 3.45, "end": 5.45, "id": "22039463-25e5-4eff-9d51-5ea7be42bc23"}, {"character": "Logan", "caption": "Quiero unas nuevas.", "start": 8.35, "end": 10.55, "id": "74700388-d553-46b3-b26a-435bf98eb48a"}, {"character": "William Stryker", "caption": "Y ¿qué nombre llevarán?", "start": 10.15, "end": 13.05, "id": "bc34c4ae-651e-48d7-8284-81903bb97fba"}, {"character": "Logan", "caption": "Lobezno.", "start": 13.95, "end": 15.85, "id": "787aa84e-41aa-4f8f-9463-019d5fae705f"}, {"character": "William Stryker", "caption": "Hoy seremos testigos de la historia médica. Hoy vamos a crear el Arma X.", "start": 19.75, "end": 25.45, "id": "b66af18f-d80e-40ed-a4f3-48fe3e70cb00"}, {"character": "General Munson", "caption": "¿X?", "start": 24.85, "end": 26.45, "id": "c367508f-1fb5-4eac-9370-b6571a3b4efe"}, {"character": "William Stryker", "caption": "En números romanos... 10.", "start": 26.45, "end": 29.35, "id": "ac3e6501-d024-4dc3-a92d-e6d499fbc905"}, {"character": "William Stryker", "caption": "Vamos a comenzar a fusionar el adamantium con el esqueleto del Arma X. Empecemos.", "start": 30.45, "end": 37.85, "id": "80c63f8e-8a8d-41f7-9205-710eb9391c96"}, {"character": "Dr. Cornelius", "caption": "Temperatura corporal 42 y medio y subiendo.", "start": 118.45, "end": 121.35, "id": "c37543dc-f99f-4c78-96e7-73d3c35d937a"}, {"character": "General Munson", "caption": "¿Por qué se revuelve así? ¿Por qué no está sedado?", "start": 123.15, "end": 126.55, "id": "fb7c28f1-d46b-47b6-a289-88cec8404f49"}, {"character": "William Stryker", "caption": "Siente dolor igual que cualquiera, pero la anestesia no le hace efecto. Por eso tenía que ser voluntario.", "start": 125.85, "end": 130.35, "id": "7eb1ab1d-bcbe-4609-a717-ae4621aed26b"}, {"character": "Dr. Cornelius", "caption": "Pulsaciones 190. 195.", "start": 129.75, "end": 133.55, "id": "027719f9-b4e2-4714-9e27-c64ff5df63cd"}, {"character": "General Munson", "caption": "¿Sobrevivirá a esto?", "start": 132.85, "end": 134.65, "id": "5ae48bff-4ffb-4529-a666-3967c4f7505d"}, {"character": "William Stryker", "caption": "No lo sé.", "start": 133.95, "end": 135.65, "id": "2ad6528f-2022-4b95-bacd-901dc41dd101"}, {"character": "Dr. Cornelius", "caption": "200.", "start": 134.95, "end": 136.55, "id": "2823f05d-915c-48ec-bfde-5e6946d69da4"}, {"character": "Thomas Logan", "caption": "¡Hijo!", "start": 137.35, "end": 139.15, "id": "1a709bf3-2349-451d-a0c2-7d25f6d20e84"}, {"character": "Dr. Carol Frost", "caption": "Pulsaciones por encima del máximo.", "start": 139.65, "end": 142.45, "id": "2a4580b2-0745-47e7-a2e8-4dba6c9101d2"}, {"character": "William Stryker", "caption": "¿Qué tensión?", "start": 141.75, "end": 143.25, "id": "a0fff363-b51a-4d11-97a8-895aa524a6bf"}, {"character": "Dr. Carol Frost", "caption": "26, 18 y subiendo.", "start": 142.65, "end": 145.15, "id": "afff2516-e5b0-46c3-8a66-bd5ded54c2ab"}, {"character": "William Stryker", "caption": "Lo superará. Sobrevivirá.", "start": 144.65, "end": 147.45, "id": "35aa611b-470f-4c4f-8b1b-67e9b45afef6"}, {"character": "Logan", "caption": "¡Victor!", "start": 150.65, "end": 152.65, "id": "dae4d369-4dc6-49dd-8b2c-2d3929699c47"}, {"character": "Logan", "caption": "¡AAAAAAAAAAH!", "start": 154.85, "end": 157.45, "id": "ce1d4493-6acb-46da-8634-6c68449146ee"}, {"character": "Kayla Silverfox", "caption": "Te quiero. Tú no eres un animal, Logan.", "start": 156.75, "end": 160.15, "id": "0f8bb22e-b4bf-4b0a-8d85-8e384167c174"}, {"character": "Kayla Silverfox", "caption": "Significa Lobezno.", "start": 204.75, "end": 207.75, "id": "31ffd45c-cf14-4274-9790-c13dddeaf2b1"}, {"character": "Dr. Cornelius", "caption": "Las reservas de adamantium se han agotado.", "start": 255.45, "end": 258.55, "id": "289c7588-30a0-4f11-9edc-502b00ed2b6c"}, {"character": "William Stryker", "caption": "No hay rechazo.", "start": 258.45, "end": 300.35, "id": "b656ec90-6f23-41df-98b2-94070a8c808b"}, {"character": "William Stryker", "caption": "Bórrenle la memoria.", "start": 299.65, "end": 303.15, "id": "99f73249-28bb-46a1-a7fb-83e2dbf55d28"}, {"character": "William Stryker", "caption": "Bórrenle la memoria.", "start": 306.45, "end": 308.55, "id": "cb627149-84a0-414e-b2a9-d271da30b448"}, {"character": "Agent Zero", "caption": "Creo que le ha oído.", "start": 317.65, "end": 319.75, "id": "7977ab92-133e-4b81-9fe7-87c48181194f"}, {"character": "Logan", "caption": "¡AAAAAAAAAAH!", "start": 324.05, "end": 329.35, "id": "538536a1-66d5-46d6-8529-b45ed02d3e92"}, {"character": "William Stryker", "caption": "¡Sacad esto!", "start": 334.65, "end": 336.55, "id": "30b31fa9-c26b-4d96-96bb-47318dc8828f"}], "characters": [{"name": "Agent Zero", "color": "#6c8cff"}, {"name": "Dr. Carol Frost", "color": "#e5636b"}, {"name": "Dr. Cornelius", "color": "#4caf7d"}, {"name": "General Munson", "color": "#d9a441"}, {"name": "Kayla Silverfox", "color": "#c471ed"}, {"name": "Logan", "color": "#41c7d9"}, {"name": "Thomas Logan", "color": "#f27b9b"}, {"name": "William Stryker", "color": "#8bc34a"}], "video_url": "/uploads/734e2efd-08d3-4c99-8ea8-5bd7b3093fae/source.mp4", "updated_at": 1787181363.2610965}