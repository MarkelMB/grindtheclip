{"job_id": "e5461d38-5f4d-49b3-90be-35e2b1882972", "pack_name": "piensa mark", "lines": [{"character": "Omni-Man", "caption": "[grunts]", "start": 0.0, "end": 4.25, "id": "a82dfcc9-86b3-4ec5-82fe-c4024c4e763e"}, {"character": "Omni-Man", "caption": "¡Mierda!", "start": 3.55, "end": 5.45, "id": "3baa039f-3868-4a28-a97c-9ec82fe980eb"}, {"character": "Omni-Man", "caption": "[pants]", "start": 8.15, "end": 10.85, "id": "14a6ebe7-66ea-4b39-bb83-b7526bbf8895"}, {"character": "Omni-Man", "caption": "[pants]", "start": 10.65, "end": 16.55, "id": "e47b63dc-af87-44e7-9b41-28d5c4a9035e"}, {"character": "Omni-Man", "caption": "[pants]", "start": 17.15, "end": 24.35, "id": "583d89e3-d900-4d40-a688-21e5820bcaa1"}, {"character": "Omni-Man", "caption": "[pants]", "start": 25.65, "end": 29.55, "id": "52e20058-d9be-4487-a565-1580f5dbbb22"}, {"character": "Omni-Man", "caption": "¿Por qué me obligas a hacer esto?", "start": 29.65, "end": 32.65, "id": "644507b1-f087-4ce2-82f9-e8f7426869b7"}, {"character": "Omni-Man", "caption": "¡Solo luchas para poder ver morir a todos los que te rodean!", "start": 32.45, "end": 36.15, "id": "7a7b77c7-469e-469e-b549-6311ea5dfc5f"}, {"character": "Omni-Man", "caption": "¡Piensa, Mark!", "start": 35.65, "end": 38.15, "id": "32e14b83-1d9d-4da3-ae2c-8edc34b80c71"}, {"character": "Omni-Man", "caption": "Vivirás más que todos los seres frágiles e insignificantes de este planeta.", "start": 37.45, "end": 41.85, "id": "debc4cf3-a61d-4113-ad54-873c52a2cbb2"}, {"character": "Omni-Man", "caption": "¡Vivirás para ver cómo este mundo se reduce a polvo y se dispersa!", "start": 41.45, "end": 47.15, "id": "4c411c42-fea5-4469-aefb-553c4397f190"}, {"character": "Omni-Man", "caption": "¡Todas las cosas y todas las personas que conoces desaparecerán!", "start": 46.65, "end": 52.15, "id": "47fd789d-c1c6-44ca-b614-bea6eb3fa627"}, {"character": "Omni-Man", "caption": "¿Qué te quedará cuando hayan pasado quinientos años?", "start": 54.25, "end": 60.15, "id": "fe0b05ed-3a2b-4