{"job_id": "8ff8e3fa-7285-4a23-b265-75d591dfacf8", "pack_name": "chocoleche", "lines": [{"character": "Coscu", "caption": "¿Chocolate negro o blanco?", "start": 0.0, "end": 2.2, "id": "70d90b9a-f427-45b1-b707-3626200f3f4c"}, {"character": "Maria Becerra", "caption": "De leche.", "start": 2.3, "end": 3.4, "id": "c98fccfc-9055-458d-b1a7-f571b3cf3fed"}, {"character": "Maria Becerra", "caption": "¡Sos un pelotudo! [laughs]", "start": 10.5, "end": 12.3, "id": "67b4e1e0-3ceb-443a-972a-4a8a831f09f5"}, {"character": "Coscu", "caption": "¡\"De leche\", boluda! [laughs]", "start": 12.3, "end": 13.5, "id": "4958db48-8ee3-4b44-ac1a-be31a0709288"}, {"character": "Maria Becerra", "caption": "Pero, ¿qué tiene? ¡Existe el de leche!", "start": 13.5, "end": 16.0, "id": "c2224e3d-2578-49e7-a691-e35935111066"}, {"character": "Coscu", "caption": "[laughs] ¡Imbécil!", "start": 16.0, "end": 17.1, "id": "84ebd7d0-9a22-4dd8-8eb4-948bd825f083"}, {"character": "Maria Becerra", "caption": "¡Imbécil! Dios, ¿ves que vos malinterpretás...?", "start": 17.0, "end": 20.5, "id": "3130ebe7-6b6a-4395-a6c2-0bc66881d5b5"}, {"character": "Coscu", "caption": "¡Vos también me pusiste caras a mí! ¡Vos también...", "start": 20.5, "end": 23.5, "id": "596ed10c-63b1-40f7-809d-c206c2777e9e"}, {"character": "Maria Becerra", "caption": "...me pusiste cara! [laughs]", "start": 21.5, "end": 23.5, "id": "057c8aa7-54a8-4034-8de2-dbf5f5bd0778"}], "characters": [{"name": "Coscu", "color": "#6c8cff"}, {"name": "Maria Becerra", "color": "#e5636b"}], "video_url": "/uploads/8ff8e3fa-7285-4a23-b265-75d591dfacf8/yt_video.mp4", "updated_at": 1787179368.9946954}