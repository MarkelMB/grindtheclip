{"job_id": "eeda52b0-2152-46e6-838f-d53e96c221a0", "pack_name": "piensa mark", "lines": [{"id": "bb4505df-f773-4bae-b080-2f67d2be9b29", "character": "Personaje 1", "caption": "¡Ah! ¡Mierda! ¿Por qué me obligas a hacer esto?", "start": 2.51, "end": 32.28}, {"id": "8f4042dd-2097-45c2-900e-3a4dd8ed1d86", "character": "Personaje 1", "caption": "Solo luchas para poder ver morir a todos los que te rodean.", "start": 32.22, "end": 36.2}, {"id": "7aaf85b8-8b3b-4aa8-a75e-74a3ef8cfe30", "character": "Personaje 1", "caption": "Piensa, Mark, vivirás más que todos los seres frágiles e insignificantes de este planeta.", "start": 35.64, "end": 41.58}, {"id": "a17e4e1e-168b-4164-af0d-7f80d87a154c", "character": "Personaje 1", "caption": "Vivirás para ver cómo este mundo se reduce a polvo y se dispersa.", "start": 41.5, "end": 46.88}, {"id": "5d61abf2-053f-440a-a324-8625460cc3c2", "character": "Personaje 1", "caption": "Todas las cosas y todas las personas que conoces desaparecerán.", "start": 46.78, "end": 51.86}, {"id": "13dfed60-c328-4825-8e25-a646e75dc88b", "character": "Personaje 1", "caption": "¿Qué te quedará cuando hayan pasado 500 años?", "start": 54.99, "end": 59.63}, {"id": "a9a57c5d-c62f-4d14-af19-1d16e1987a05", "character": "Personaje 1", "caption": "¡Tú papá! ¡Me quedarías tú!", "start": 58.93, "end": 65.75}], "characters": [{"name": "Personaje 1", "color": "#6c8cff"}], "video_url": "/uploads/eeda52b0-2152-46e6-838f-d53e96c221a0/yt_video.mp4", "updated_at": 1787515748.8954966}