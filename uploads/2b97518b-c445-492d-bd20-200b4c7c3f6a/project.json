{"job_id": "2b97518b-c445-492d-bd20-200b4c7c3f6a", "pack_name": "piensa mark", "lines": [{"id": "062364d8-cc8e-4d7f-942f-c8ea9f26acc6", "character": "Personaje 1", "caption": "¡Ah! ¡Mierda! ¿Por qué me obligas a hacer esto?", "start": 2.51, "end": 32.27}, {"id": "8bcd5760-39d5-42f9-9424-b3d59660b85e", "character": "Personaje 1", "caption": "Solo luchas para poder ver morir a todos los que te rodean.", "start": 32.19, "end": 36.19}, {"id": "9774b795-c189-4e28-be0d-97e1f0eb6bf5", "character": "Personaje 1", "caption": "Piensa, Mark, vivirás más que todos los seres frágiles e insignificantes de este planeta.", "start": 35.65, "end": 41.57}, {"id": "3c0f4aaf-6fc0-4701-9851-32678a90a9ad", "character": "Personaje 1", "caption": "Vivirás para ver cómo este mundo se reduce a polvo y se dispersa.", "start": 41.49, "end": 46.87}, {"id": "2ce95812-e6fc-4c6a-b172-e2b0e3b8ad22", "character": "Personaje 1", "caption": "Todas las cosas y todas las personas que conoces desaparecerán.", "start": 46.79, "end": 51.89}, {"id": "74a7dec2-efb1-4ba0-8cdc-18277034c1c7", "character": "Personaje 1", "caption": "¿Qué te quedará cuando hayan pasado 500 años?", "start": 55.03, "end": 59.63}, {"id": "f63b2736-bdb7-484c-a95c-981036e1f2b3", "character": "Personaje 1", "caption": "¡Tú papá! ¡Me caerías tú!", "start": 58.93, "end": 65.73}], "characters": [{"name": "Personaje 1", "color": "#6c8cff"}], "video_url": "/uploads/2b97518b-c445-492d-bd20-200b4c7c3f6a/yt_video.mp4", "updated_at": 1787515421.9466221}