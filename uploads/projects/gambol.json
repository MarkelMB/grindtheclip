{"name": "gambol", "title": "gambol", "video": "/uploads/9dd31a1c-cf6d-4058-a23e-e310c0cd2993/yt_video.mp4", "local_video_path": null, "characters": [{"name": "Actor", "color": "#22d3ee"}, {"name": "Richard Watterson", "color": "#e5636b"}, {"name": "Gumball", "color": "#4caf7d"}, {"name": "Gumball Watterson", "color": "#d9a441"}, {"name": "Tobias Wilson", "color": "#c471ed"}, {"name": "Harold Wilson", "color": "#41c7d9"}, {"name": "Jackie Wilson", "color": "#f27b9b"}, {"name": "Darwin", "color": "#8bc34a"}, {"name": "Announcer", "color": "#22d3ee"}, {"name": "Mr. Small", "color": "#e5636b"}, {"name": "Voz del cassette", "color": "#4caf7d"}, {"name": "Señor Pequeño", "color": "#d9a441"}, {"name": "Hector", "color": "#c471ed"}], "lines": [{"id": "68f11ded-26f7-4465-9160-ea7b802942ad", "character": "Actor", "caption": "Cada jornada es un círculo que se vuelve cuadrado,", "start": 0.39, "end": 3.09, "confidence": 0.95}, {"id": "b0cf6a16-b929-4ab8-a9ae-caa5b948c22e", "character": "Actor", "caption": "pero no puedes cuadrar el círculo.", "start": 3.85, "end": 6.23, "confidence": 0.95}, {"id": "f377ca38-33e7-4671-ad05-b2f5c0bdfbff", "character": "Actor", "caption": "Solo puedes correr.", "start": 7.09, "end": 8.17, "confidence": 0.95}, {"id": "eab5b957-99f8-4e5b-9849-5e0d1d5147ae", "character": "Actor", "caption": "Correr hacia ti,", "start": 9.49, "end": 10.98, "confidence": 0.95}, {"id": "78529d9f-f7f5-4a92-80b9-60402d0f4cfb", "character": "Actor", "caption": "hacia mí,", "start": 12.13, "end": 13.28, "confidence": 0.95}, {"id": "5589f21c-bbd8-407f-b105-7797d81a22e4", "character": "Actor", "caption": "hacia afuera de todo,", "start": 15.77, "end": 17.48, "confidence": 0.95}, {"id": "3de827b2-15dc-4732-85ab-15adf935e9ab", "character": "Actor", "caption": "adentro de la nada,", "start": 18.45, "end": 19.71, "confidence": 0.95}, {"id": "e01107ed-4aef-491b-b630-61a0b56ac7f0", "character": "Actor", "caption": "en fin y eternidad o...", "start": 20.75, "end": 23.48, "confidence": 0.95}, {"id": "ed665c30-e26f-444e-b123-12e2a5341891", "character": "Actor", "caption": "¡Okay, okay! ¡Ya puedes saltar el video!", "start": 23.35, "end": 25.48, "confidence": 0.95}, {"id": "5b0f4723-b3b4-468a-9512-63ed81190bfe", "character": "Actor", "caption": "¿Qué prisa?", "start": 25.45, "end": 26.68, "confidence": 0.95}, {"id": "6005056b-9f84-4740-8b95-cace0fe4ff77", "character": "Richard Watterson", "caption": "Ah, hola. Esta semana reseñaré un juego que forma parte de mi computadora.", "start": 27.43, "end": 30.68, "confidence": 0.95}, {"id": "39ef7446-fe0f-46f9-8af1-a8054820d896", "character": "Richard Watterson", "caption": "No es tan bueno como Buscaminas o Solitario...", "start": 30.65, "end": 33.78, "confidence": 0.95}, {"id": "03cb10db-2a4d-474c-8c1e-1bf2059767c3", "character": "Richard Watterson", "caption": "Okay, ahora yo voy a cargar el juego.", "start": 36.05, "end": 38.88, "confidence": 0.95}, {"id": "d1d63309-893e-4964-8a7e-8101f5b16ada", "character": "Richard Watterson", "caption": "Bien, se llama Calculadora.", "start": 38.75, "end": 40.68, "confidence": 0.95}, {"id": "d82fddd6-ccf4-460f-ac13-b3fb38a81d6f", "character": "Richard Watterson", "caption": "Eliges a tu personaje y tomas un par de binoculares.", "start": 43.15, "end": 47.14, "confidence": 0.95}, {"id": "7f4db6db-6d41-459e-9eea-e9b2da034f79", "character": "Richard Watterson", "caption": "Tienes que encontrar el tesoro marcado con una X, obviamente.", "start": 47.05, "end": 51.28, "confidence": 0.95}, {"id": "f8fc6c57-77fd-4989-8d10-37b9508466ae", "character": "Richard Watterson", "caption": "Pero ten cuidado, porque cuando llegas al tesoro, hay una serpiente.", "start": 51.37, "end": 55.78, "confidence": 0.95}, {"id": "9e561224-117f-458c-99a8-d0da4d13c1d6", "character": "Richard Watterson", "caption": "Pero está bien porque puedes tomar un hacha o un arco y la flecha y", "start": 56.45, "end": 60.78, "confidence": 0.95}, {"id": "bb89e0ad-075f-489f-a37d-b469c2c7d42c", "character": "Richard Watterson", "caption": "ve cuánto hiciste. Oigan, tengo un marcador muy alto.", "start": 61.95, "end": 65.41, "confidence": 0.95}, {"id": "5c47c235-20d9-47e0-8fc7-d79ba54149c2", "character": "Richard Watterson", "caption": "Una crítica que tengo es que no hay personajes femeninos,", "start": 65.95, "end": 69.48, "confidence": 0.95}, {"id": "8de975c9-cf1c-4a15-a4c9-a2d46a1fc1cc", "character": "Richard Watterson", "caption": "pero no hay masculinos tampoco, así que está bien.", "start": 69.35, "end": 72.38, "confidence": 0.95}, {"id": "ccbdfce9-9309-483e-bb01-6ffcfc59bb92", "character": "Richard Watterson", "caption": "Hay un par de errores con ciertos comandos", "start": 72.59, "end": 76.57, "confidence": 0.95}, {"id": "d6735059-445f-42d6-b9c1-a790830e0808", "character": "Richard Watterson", "caption": "como cuando quieres usar el arco y el globo.", "start": 76.25, "end": 79.58, "confidence": 0.95}, {"id": "16364cce-4be5-417c-b832-19179e401c8d", "character": "Richard Watterson", "caption": "Vean lo que pasa.", "start": 79.45, "end": 80.94, "confidence": 0.95}, {"id": "5d0b4276-bc80-4880-8645-12c812ca1e55", "character": "Richard Watterson", "caption": "Es un buen juego, 8 de 10, lo jugaría otra vez.", "start": 82.8, "end": 85.6, "confidence": 0.95}, {"id": "f92fa37d-e63e-4a48-9d46-9312031d0788", "character": "Gumball", "caption": "¡Jajaja! Gorila contra ballena asesina.", "start": 86.83, "end": 88.98, "confidence": 0.95}, {"id": "ff1499da-d55e-40b8-8d81-fed76f014b0f", "character": "Gumball Watterson", "caption": "¡Ah, engaño!", "start": 92.98, "end": 94.35, "confidence": 0.9}, {"id": "bb520c21-c415-484d-8cb4-2db843d0161c", "character": "Gumball", "caption": "Un engaño.", "start": 92.98, "end": 94.35, "confidence": 0.95}, {"id": "2f7d363d-ed20-47e3-99c4-00e10a00fc60", "character": "Tobias Wilson", "caption": "Hola, soy Tobias Wilson y esta broma se llama...", "start": 97.19, "end": 100.18, "confidence": 0.95}, {"id": "fa811bc4-8abe-4e54-89b5-7a7f99016db7", "character": "Tobias Wilson", "caption": "¡Ya levántate!", "start": 100.25, "end": 101.58, "confidence": 0.95}, {"id": "31a15ead-27b5-41da-a058-8406aeab4c70", "character": "Tobias Wilson", "caption": "De acuerdo, son las 5:00 a.m. y mi papá se va a levantar para ir a trabajar,", "start": 104.95, "end": 108.88, "confidence": 0.95}, {"id": "0ad55c9f-4be7-49d4-8ee7-b2e5ee429bd1", "character": "Tobias Wilson", "caption": "pero puse mi patineta bajando las escaleras.", "start": 108.85, "end": 111.68, "confidence": 0.95}, {"id": "8632dda1-41b0-4b9c-aeee-783dae2d3df5", "character": "Tobias Wilson", "caption": "¡Shh! Vamos a ver qué pasa.", "start": 112.95, "end": 115.28, "confidence": 0.95}, {"id": "2a920f8f-4a71-4057-b267-d61269dd3e28", "character": "Harold Wilson", "caption": "¡Nena, nos están robando!", "start": 119.05, "end": 120.98, "confidence": 0.95}, {"id": "53e24683-7c56-4de7-a09a-60f8a0f150a3", "character": "Jackie Wilson", "caption": "¡Ahhh!", "start": 121.05, "end": 122.28, "confidence": 0.95}, {"id": "42f37275-338b-478b-a299-af59b60a8059", "character": "Harold Wilson", "caption": "¡Policía, tenemos un intruso! Sí.", "start": 121.75, "end": 123.88, "confidence": 0.95}, {"id": "3b251398-a516-4fb7-ac08-5d435c851c60", "character": "Harold Wilson", "caption": "¡Está armado, es peligroso! Usa gorra de rapero.", "start": 123.75, "end": 126.88, "confidence": 0.95}, {"id": "26d25a9d-8bd1-4c4f-a85b-101b46075900", "character": "Tobias Wilson", "caption": "¡Ah!", "start": 124.05, "end": 125.08, "confidence": 0.9}, {"id": "b2198709-f9ba-4ce0-92e9-428933b7bb18", "character": "Tobias Wilson", "caption": "¡Soy yo! Es una broma. Cayeron ante Tobías. ¡Jajaja!", "start": 126.95, "end": 130.38, "confidence": 0.95}, {"id": "239cec81-5d8c-4481-a2bf-ee8ac7b1a5e6", "character": "Harold Wilson", "caption": "Por supuesto. Pues de repente este horrible acto se vuelve divertido.", "start": 132.95, "end": 136.98, "confidence": 0.95}, {"id": "9bf1c19a-3a40-4a4e-814e-bb77bb2ba297", "character": "Harold Wilson", "caption": "¡Creí que mi familia estaba en peligro mortal, pero no era así! ¡Jajajaja!", "start": 137.45, "end": 142.08, "confidence": 0.95}, {"id": "45078aae-6712-47ff-b249-a2e5d44026ec", "character": "Harold Wilson", "caption": "Estás castigado.", "start": 143.45, "end": 145.2, "confidence": 0.95}, {"id": "9cdbb6ae-9051-45b2-b0eb-e01f9d185599", "character": "Tobias Wilson", "caption": "Esta fue una broma extrema con Tobías Wilson.", "start": 146.01, "end": 148.83, "confidence": 0.95}, {"id": "b153d70a-d539-4934-9fc8-25e413d9d3a5", "character": "Darwin", "caption": "Ah...", "start": 149.95, "end": 150.98, "confidence": 0.85}, {"id": "add6afb7-5f92-43e2-863a-a33798bc8981", "character": "Gumball", "caption": "¿Qué? ¿El corto de cine del Increíble Mundo de Gumball?", "start": 151.25, "end": 154.48, "confidence": 0.95}, {"id": "7370ddb7-6e6f-4887-9d96-cd1d87a558ee", "character": "Gumball Watterson", "caption": "¿Qué? ¿El corto de cine del Increíble Mundo de Gumball?", "start": 151.25, "end": 154.58, "confidence": 0.95}, {"id": "1d3c0252-a739-4867-9b3a-8948d1df7141", "character": "Darwin", "caption": "¡Dale click!", "start": 154.4, "end": 155.27, "confidence": 0.95}, {"id": "e19b4a5c-824e-4197-bb97-2b17b4c1117c", "character": "Announcer", "caption": "Este corto ha sido autorizado para todo el público por la Asociación Cinematográfica de Elmore.", "start": 156.77, "end": 160.03, "confidence": 0.95}, {"id": "2b51ac14-2201-4bdc-aca0-672d76a75c72", "character": "Announcer", "caption": "Un pequeño momento de calma.", "start": 165.02, "end": 166.88, "confidence": 0.9}, {"id": "e34a3c78-0aa8-465b-8098-2df11203556d", "character": "Mr. Small", "caption": "Bienvenidos al pequeño momento de calma conmigo, el Señor Pequeño.", "start": 167.23, "end": 171.51, "confidence": 0.95}, {"id": "8bae69e2-1372-4252-91de-92fb86d96075", "character": "Mr. Small", "caption": "Debí haberlo llamado Pequeño momento de calma.", "start": 171.45, "end": 173.98, "confidence": 0.95}, {"id": "3ab2067d-c80b-4e4c-a8d8-a8d1dd3cff91", "character": "Mr. Small", "caption": "Como sea, liberen sus chakras.", "start": 173.95, "end": 176.18, "confidence": 0.95}, {"id": "7a101d62-dd96-4ffb-9c02-486da1cdc734", "character": "Mr. Small", "caption": "Se los demostraré usando mi nuevo disco.", "start": 176.25, "end": 179.08, "confidence": 0.95}, {"id": "5575b66c-66fe-4410-a581-2a5260dfcd17", "character": "Mr. Small", "caption": "Ahora disponible en estaciones de gas y supermercados...", "start": 179.25, "end": 182.18, "confidence": 0.95}, {"id": "226afbd4-2591-4bea-a3ba-5a4fdefb7d74", "character": "Voz del cassette", "caption": "Estas son las ofertas de los supermercados... ¡en rebajas!", "start": 179.95, "end": 182.84, "confidence": 0.95}, {"id": "cfcfd6b8-61d9-4fd8-a85a-ba9f1723f8d5", "character": "Mr. Small", "caption": "...en rebajas.", "start": 182.05, "end": 182.84, "confidence": 0.95}, {"id": "fca53644-77a9-48e5-a45c-15690adb64cc", "character": "Voz del cassette", "caption": "Abran su pecho y relájense.", "start": 183.95, "end": 186.18, "confidence": 0.95}, {"id": "8338f4fc-0fa3-4b88-abc5-0c493c87091b", "character": "Voz del cassette", "caption": "Inhalen.", "start": 188.36, "end": 189.78, "confidence": 0.95}, {"id": "48b1fe26-662a-43b7-b406-5e5d48b6c61e", "character": "Señor Pequeño", "caption": "[Inhala]", "start": 189.05, "end": 190.57, "confidence": 0.9}, {"id": "356d6950-f560-4e63-a400-19bf869a08a4", "character": "Voz del cassette", "caption": "Exhalen.", "start": 190.45, "end": 192.28, "confidence": 0.95}, {"id": "0509560a-994a-4502-a4f3-2c6ee39f77d7", "character": "Señor Pequeño", "caption": "[Exhala]", "start": 190.92, "end": 192.95, "confidence": 0.9}, {"id": "4f8c6927-4e96-4d5e-95f3-eca3b4aadef6", "character": "Voz del cassette", "caption": "Inhalen.", "start": 192.34, "end": 194.08, "confidence": 0.95}, {"id": "f0afcd74-a619-483c-8f99-64a96a39b110", "character": "Señor Pequeño", "caption": "[Inhala]", "start": 193.15, "end": 194.48, "confidence": 0.9}, {"id": "27719021-2217-47e2-9de1-74daba54c930", "character": "Voz del cassette", "caption": "Exhalen, exhalen, exhalen...", "start": 194.65, "end": 196.36, "confidence": 0.95}, {"id": "9a91eeb0-64ab-4701-99a6-f2632d31357f", "character": "Voz del cassette", "caption": "Exhalen, exhalen, exhalen...", "start": 199.95, "end": 201.58, "confidence": 0.95}, {"id": "8fd7310f-7eee-476c-93cc-40e6772c9a3b", "character": "Señor Pequeño", "caption": "[Gime de agobio]", "start": 204.95, "end": 206.58, "confidence": 0.9}, {"id": "510d1b56-2e40-41b9-9e1e-6d901a5a2986", "character": "Mr. Small", "caption": "Exhala.", "start": 209.95, "end": 211.08, "confidence": 0.9}, {"id": "3aaa1a45-2234-4eea-af0c-98b3f5c391ff", "character": "Mr. Small", "caption": "Exhala.", "start": 211.95, "end": 213.28, "confidence": 0.9}, {"id": "c3034aa0-c58b-44a5-8bda-0b19396c451d", "character": "Mr. Small", "caption": "Después de todo, el yoga es renacimiento.", "start": 215.45, "end": 218.28, "confidence": 0.95}, {"id": "322f91c1-463d-4429-b5f2-739c52e52e61", "character": "Mr. Small", "caption": "Namaste.", "start": 219.25, "end": 220.58, "confidence": 0.95}, {"id": "62d9369b-c72f-4be9-a8ab-09ef28e57e15", "character": "Gumball", "caption": "Tengo que blanquearme los ojos después de eso.", "start": 222.05, "end": 223.88, "confidence": 0.95}, {"id": "c1d26601-c132-4dcb-aef7-0456dbb1a13f", "character": "Darwin", "caption": "Creo que necesitamos algo lindo.", "start": 223.75, "end": 225.45, "confidence": 0.95}, {"id": "20e894c0-5a8a-4122-8b31-c059fb2f91db", "character": "Gumball", "caption": "¡Ay!", "start": 226.33, "end": 227.48, "confidence": 0.9}, {"id": "557ba95d-d06d-4d89-8cc7-c40bbcce6e37", "character": "Gumball", "caption": "¡Oh, vamos!", "start": 228.75, "end": 230.08, "confidence": 0.95}, {"id": "04a2599e-c15a-4e87-805c-014cf9f8d92a", "character": "Gumball", "caption": "Uh, ¡error épico!", "start": 231.43, "end": 233.34, "confidence": 0.95}, {"id": "4e2fe008-51e4-403e-8589-915e4d2b9e95", "character": "Hector", "caption": "Ja, ja, ja, ja, ja.", "start": 237.85, "end": 240.08, "confidence": 0.9}, {"id": "87e8c4b3-1b9a-4062-a9a3-598bf4bb326e", "character": "Hector", "caption": "¡Miren eso! Jajajaja", "start": 239.95, "end": 241.58, "confidence": 0.85}, {"id": "696e8f04-62cd-4bc3-8b25-5507c5eb49aa", "character": "Gumball", "caption": "Es el primero de los que he visto que en verdad es épico.", "start": 244.39, "end": 246.91, "confidence": 0.95}, {"id": "8f7a1194-ad0a-4bc6-ba54-6e9f9440bcf5", "character": "Gumball", "caption": "Ah, ¿qué hizo Joe ahora?", "start": 246.95, "end": 248.9, "confidence": 0.95}], "authors": "", "readme": "", "jobId": "9dd31a1c-cf6d-4058-a23e-e310c0cd2993"}