{"job_id": "b7d21dd6-7fb1-449a-b8d0-2eec8ee89b83", "pack_name": "joseph salir por patas", "lines": [{"character": "Joseph Joestar", "caption": "No, tengo un plan.", "start": 0.0, "end": 2.3, "id": "e8c83b7d-3ccc-41f3-850c-4c20c62ae57b"}, {"character": "Speedwagon", "caption": "Pero, ¿qué has dicho, JoJo?", "start": 4.0, "end": 6.1, "id": "4211355e-719c-4c44-87c6-7600765393d7"}, {"character": "Joseph Joestar", "caption": "Cuida de ella. Así es. Eso he dicho, me queda un único plan.", "start": 7.7, "end": 12.7, "id": "dd2eef18-3b97-4f78-9189-466c837b4221"}, {"character": "Rudol von Stroheim", "caption": "¿Un... único plan?", "start": 13.2, "end": 15.1, "id": "59a1a941-36ec-4a0d-b034-a5e8c254d8ab"}, {"character": "Joseph Joestar", "caption": "Sí, es mi as en la manga.", "start": 15.2, "end": 17.5, "id": "10ac01bf-60f7-4591-b106-0cd8069dbcb5"}, {"character": "Rudol von Stroheim", "caption": "¿As en la manga?", "start": 18.0, "end": 20.1, "id": "84bacdd4-5f8e-4eb8-8e87-24c8cab34ff5"}, {"character": "Smokey Brown", "caption": "JoJo, JoJo, ¿no será ese plan que estás diciendo, no será...?", "start": 20.2, "end": 25.2, "id": "a8d209c7-4d39-4f74-b97f-cf053d4ad7fe"}, {"character": "Joseph Joestar", "caption": "¡Escucha! ¡Voy a hacerlo hasta que me quede sin aliento!", "start": 25.6, "end": 28.8, "id": "0fe530ef-78e1-4cbe-88f4-e802321aa4dc"}, {"character": "Rudol von Stroheim", "caption": "¿Quedarte sin aliento? ¿Qué vas a hacer?", "start": 29.0, "end": 31.7, "id": "bf6d08ae-357d-4544-bc51-35da8abcd1a8"}, {"character": "Joseph Joestar", "caption": "¡Salir por patas!", "start": 37.3, "end": 39.7, "id": "7074dbb0-c919-42f1-bfc4-6eab4d4376ee"}, {"character": "Smokey Brown", "caption": "¡Es que lo sabía!", "start": 40.2, "end": 42.8, "id": "fb7fc6c6-fc5d-48e5-9d67-a27d827dcaff"}], "characters": [{"name": "Joseph Joestar", "color": "#6c8cff"}, {"name": "Rudol von Stroheim", "color": "#e5636b"}, {"name": "Smokey Brown", "color": "#4caf7d"}, {"name": "Speedwagon", "color": "#d9a441"}