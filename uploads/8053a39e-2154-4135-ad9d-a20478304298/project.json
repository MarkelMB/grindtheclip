{"job_id": "8053a39e-2154-4135-ad9d-a20478304298", "pack_name": "gambol", "lines": [{"id": "a5026bd6-0138-48cb-8088-c162fb4535c6", "character": "Commercial Voice", "caption": "Cada jornada es un círculo que se vuelve cuadrado.", "start": 0.3, "end": 3.5}, {"id": "146ab18c-6eed-4cf9-87de-f9e614479a28", "character": "Commercial Voice", "caption": "Pero no puedes cuadrar el círculo.", "start": 4.2, "end": 6.8}, {"id": "412a00e4-e7d3-4819-a32d-6a724e795fc9", "character": "Commercial Voice", "caption": "Solo puedes correr.", "start": 7.1, "end": 8.8}, {"id": "a790aec3-f7c6-4c01-9a86-4066ca6d94ad", "character": "Commercial Voice", "caption": "Correr hacia ti.", "start": 9.1, "end": 10.5}, {"id": "ee1b85df-7a44-468a-aab1-87f9e0172080", "character": "Commercial Voice", "caption": "Hacia mí.", "start": 11.8, "end": 13.1}, {"id": "d8decd11-4b09-49b6-95e5-8d89a9633d5a", "character": "Commercial Voice", "caption": "Hacia nosotros.", "start": 13.5, "end": 15.0}, {"id": "f0238d5d-435c-4d9e-93ee-73886d6107ec", "character": "Commercial Voice", "caption": "Hacia afuera de todo.", "start": 15.3, "end": 17.2}, {"id": "28027c06-3787-40a7-8da7-2a88fdd9e0ef", "character": "Commercial Voice", "caption": "Adentro de la nada.", "start": 17.9, "end": 19.8}, {"id": "43c6d9a2-0a26-4597-9d16-2d0942b3325f", "character": "Commercial Voice", "caption": "En fin, eternidad o...", "start": 21.0, "end": 23.5}, {"id": "39be492c-f81c-44bc-bb6a-57a0b9499aa4", "character": "Commercial Voice", "caption": "Okay, okay, ¡ya puedes saltar el vídeo! Qué prisa.", "start": 23.8, "end": 26.5}, {"id": "be3ee221-d97f-48fc-984e-02b075d4a7d2", "character": "Richard Watterson", "caption": "Eh, hola. Esta semana reseñaré un juego que forma parte de mi computadora. No es tan bueno como Buscaminas o Solitario, pero vale la pena.", "start": 27.5, "end": 36.2}, {"id": "b35488d3-1099-4916-801d-8119da088960", "character": "Richard Watterson", "caption": "Okay, ahora yo voy a cargar el juego.", "start": 36.5, "end": 40.8}, {"id": "9669477c-070a-451e-8d9c-96ef4062a03d", "character": "Richard Watterson", "caption": "Bien, se llama Calculadora.", "start": 41.1, "end": 43.7}, {"id": "f8f26d8f-6923-40ca-a050-08f5ba53563c", "character": "Richard Watterson", "caption": "Eliges a tu personaje y tomas un par de binoculares.", "start": 44.0, "end": 47.4}, {"id": "57ea51ff-3a46-46ff-9811-884528d7c7b7", "character": "Richard Watterson", "caption": "Tienes que encontrar el tesoro marcado con una X, obviamente. ¡Ja, ja!", "start": 47.8, "end": 52.0}, {"id": "dbf4d84b-49ff-409b-8176-6597069762fe", "character": "Richard Watterson", "caption": "Pero ten cuidado, porque cuando llegas al tesoro, hay una serpiente.", "start": 52.2, "end": 57.6}, {"id": "b022ad67-71ab-4756-a38c-989cb9013cda", "character": "Richard Watterson", "caption": "Pero está bien porque puedes tomar un hacha o un arco y la flecha y matarla. Luego ve cuánto hiciste.", "start": 57.8, "end": 103.5}, {"id": "32e55829-564f-41bd-bcac-e07fa858d9dd", "character": "Richard Watterson", "caption": "¡Oigan, tengo un marcador muy alto!", "start": 103.7, "end": 105.5}, {"id": "07f4a7ec-5255-428b-8cfb-38be433cc395", "character": "Richard Watterson", "caption": "Una crítica que tengo es que no hay personajes femeninos, pero no hay masculinos tampoco, así que está bien.", "start": 106.5, "end": 112.5}, {"id": "4aeb4be7-056e-4da2-b0c8-99953cf705c2", "character": "Richard Watterson", "caption": "Hay un par de errores con ciertos comandos, como cuando quieres usar el arco y el globo, ¡vean lo que pasa!", "start": 113.0, "end": 121.0}, {"id": "223ee191-9a11-48fe-b648-23e96d6a2286", "character": "Richard Watterson", "caption": "[screams]", "start": 121.2, "end": 122.0}, {"id": "c504b876-0e67-41f9-87ec-ca183b6afadd", "character": "Richard Watterson", "caption": "Es un buen juego, 8 de 10, lo jugaría otra vez.", "start": 123.0, "end": 125.8}, {"id": "11abfac4-b752-46e1-9e3f-c5735139f7a5", "character": "Gumball Tristopher Watterson", "caption": "¡Ja, ja! Gorila contra ballena asesina.", "start": 126.8, "end": 128.8}, {"id": "75752adc-3596-487a-90cf-2f8df93fdb7d", "character": "Gumball Tristopher Watterson", "caption": "¡Ah, engaño!", "start": 133.0, "end": 134.5}, {"id": "dbcdb522-e145-4a3c-9da3-941687841ff3", "character": "Tobias Wilson", "caption": "Hola, soy Tobias Wilson, y esta broma se llama ¡Ya levántate! ¡Sí!", "start": 136.2, "end": 144.8}, {"id": "2afd66ee-91a8-4b98-9ca5-9d14629f5031", "character": "Tobias Wilson", "caption": "De acuerdo, son las 5:00 a.m. y mi papá se va a levantar para ir a trabajar, pero puse mi patineta bajando las escaleras.", "start": 145.3, "end": 152.8}, {"id": "a198aac3-35c7-4988-9b86-4a8b20fd1eee", "character": "Tobias Wilson", "caption": "¡Shh! Vamos a ver qué pasa.", "start": 153.0, "end": 156.2}, {"id": "6e3df006-6616-4f99-a1a6-6ed167376f07", "character": "Harold Wilson", "caption": "[groans]", "start": 157.5, "end": 159.0}, {"id": "c3bed9fb-046d-4566-825b-221cd16cf27d", "character": "Harold Wilson", "caption": "Pero ¿qué? ¡Nena! ¡Nos están robando! ¡Policía, tenemos un intruso! ¡Sí, está armado y es peligroso! ¡Usa gorra de rapero!", "start": 159.1, "end": 207.0}, {"id": "ca3141d0-7c4a-4fb1-86b2-b9fad13d85e1", "character": "Tobias Wilson", "caption": "¡Soy yo! ¡Es una broma! Cayeron ante Tobias. ¡Ja, ja, ja!", "start": 207.1, "end": 213.0}, {"id": "315a63bc-e515-4e35-9cff-40189ebd8eae", "character": "Harold Wilson", "caption": "Por supuesto. Pues de repente este horrible acto se vuelve divertido. ¡Ha, ha, ha! Creí que mi familia estaba en peligro mortal, ¡pero no era así! ¡Ha, ha, ha! Estás castigado.", "start": 213.2, "end": 224.0}, {"id": "8c6703ee-8504-48ac-a87f-6573196a3ca9", "character": "Tobias Wilson", "caption": "[sighs]", "start": 224.5, "end": 225.5}, {"id": "5df3c528-bf53-483d-a397-8db7d6ac94fe", "character": "Tobias Wilson", "caption": "Esta fue una broma extrema con Tobias Wil-", "start": 225.8, "end": 228.8}, {"id": "9b8a8edd-8b45-4231-ae85-1c084a6b2c4e", "character": "Gumball Tristopher Watterson", "caption": "¿Qué? ¿El corto de cine de El increíble mundo de Gumball? Dale clic.", "start": 230.8, "end": 235.0}, {"id": "bfe3bebc-0621-43de-abc7-e204b0a38f95", "character": "Announcer", "caption": "Este corto ha sido autorizado para todo el público por la Asociación Cinematográfica de Elmore.", "start": 236.5, "end": 240.0}, {"id": "3097083e-173e-4d37-9d73-87a842f0c247", "character": "Gumball Tristopher Watterson", "caption": "¡Ah!", "start": 242.0, "end": 242.5}, {"id": "b29b8d76-2d46-4c1d-8174-22aee3a41161", "character": "Mr. Small", "caption": "Bienvenidos al pequeño momento de calma conmigo, el Sr. Small. Debía haberlo llamado 'Pequeño momento de calma'. Como sea.", "start": 247.0, "end": 249.13}], "characters": [{"name": "Announcer", "color": "#6c8cff"}, {"name": "Commercial Voice", "color": "#e5636b"}, {"name": "Gumball Tristopher Watterson", "color": "#4caf7d"}, {"name": "Harold Wilson", "color": "#d9a441"}, {"name": "Mr. Small", "color": "#c471ed"}, {"name": "Richard Watterson", "color": "#41c7d9"}, {"name": "Tobias Wilson", "color": "#f27b9b"}], "video_url": "/uploads/8053a39e-2154-4135-ad9d-a20478304298/yt_video.mp4", "updated_at": 1787522795.67538}