{"job_id": "4f7af330-e105-4cd1-8454-7d2f7f52485f", "pack_name": "ai que te como el txitxingorri", "lines": [{"character": "Reporter", "caption": "¿Se ve bien?", "start": 0.0, "end": 1.1, "id": "c3fbd642-625b-4e35-8c54-5b8df48c176b"}, {"character": "Man", "caption": "Gracias.", "start": 1.1, "end": 2.1, "id": "62ddb4d0-dae6-4aeb-8a64-743e8d85dd2d"}, {"character": "Reporter", "caption": "A ver qué pasa aquí.", "start": 2.1, "end": 3.8, "id": "e1f77024-efae-43f8-8a38-89abbfbbcc5d"}, {"character": "Reporter", "caption": "Ven aquí. ¿Qué te pasa a ti?", "start": 5.5, "end": 8.3, "id": "186bdb00-1c91-4d55-84b9-71df8a1836cf"}, {"character": "Reporter", "caption": "¿Qué te pasa?", "start": 8.3, "end": 10.0, "id": "80c9708a-999d-41db-9a54-cc04a91ed39c"}, {"character": "Man", "caption": "Es que soy tímido.", "start": 10.0, "end": 11.5, "id": "73208f63-43b2-4d56-b05c-b43eec38c070"}, {"character": "Reporter", "caption": "No te creo.", "start": 11.5, "end": 13.0, "id": "ab12d31c-ec65-48ec-b438-cb32c95a4a67"}, {"character": "Reporter", "caption": "¿Qué haces aquí en la playa?", "start": 13.5, "end": 15.1, "id": "0095af80-5cfc-436f-88c1-150cc2be0d46"}, {"character": "Man", "caption": "A fisgonear. Hemos venido a una despedida de... una chica que se ha casado del taller.", "start": 15.1, "end": 21.3, "id": "42a39ee9-532a-4875-ab07-ea75ba5143fb"}, {"character": "Reporter", "caption": "No te pongas a llorar, no hombre. Dejarle... dejarle vivir, criatura.", "start": 21.3, "end": 25.1, "id": "258b7a7f-38fe-445b-9b5c-7269ba847770"}, {"character": "Reporter", "caption": "Pero a la playa no se viene así.", "start": 25.1, "end": 27.2, "id": "4999ac57-c2ad-416e-9151-bc4494210fbd"}, {"character": "Man", "caption": "Ah, ya, ya, ya. ¿Y así?", "start": 28.0, "end": 29.8, "id": "78ebf875-f39d-4c5f-b3e3-2b16d5ea75fb"}, {"character": "Reporter", "caption": "¿Qué, te parece mal cómo he venido?", "start": 30.0, "end": 32.2, "id": "6f9ab814-fcad-443b-b8a6-3109d19c8921"}, {"character": "Man", "caption": "Yo te cambiaba el cuerpo ahora yo, ¿eh?", "start": 32.2, "end": 34.3, "id": "22bf3f22-1477-436a-9742-d23a78921f32"}, {"character": "Reporter", "caption": "Si quieres te dejo el modelito. ¿Te dejo yo el modelito o qué?", "start": 35.5, "end": 39.5, "id": "f554c7aa-4f62-4019-91ba-424d484aeb91"}, {"character": "Man", "caption": "Hombre, no me entraría, pero...", "start": 39.5, "end": 41.2, "id": "3938c078-9174-42bb-b371-dbaf7d599c4a"}, {"character": "Reporter", "caption": "¿Cómo no te va a entrar? Si es elástico, hombre, esto es elástico, no te preocupes.", "start": 41.2, "end": 44.8, "id": "c3328ae5-0b5c-4b23-b32f-a51cf49e1b75"}, {"character": "Man", "caption": "No me hagas sudar, joder.", "start": 45.0, "end": 47.0, "id": "734b7170-51aa-47e9-b3ec-e2600748e424"}, {"character": "Reporter", "caption": "Será por el calor.", "start": 47.0, "end": 48.6, "id": "d2dedd36-7dde-46f5-8d93-c6a39d3479e8"}, {"character": "Man", "caption": "No, por todo.", "start": 48.6, "end": 49.8, "id": "a93d8b9d-d034-448a-8721-b1c34a80b869"}, {"character": "Reporter", "caption": "¿Qué?", "start": 50.8, "end": 51.3, "id": "f8438469-a393-415e-b37c-e38d8e982def"}, {"character": "Man", "caption": "En la tele te veo más maja.", "start": 51.3, "end": 53.0, "id": "691257f4-6a59-4b92-9dee-26ee6db049f5"}, {"character": "Reporter", "caption": "Vale. O sea...", "start": 53.0, "end": 54.0, "id": "59bdddc1-035a-4cf5-bdb9-b7fb2908924e"}, {"character": "Man", "caption": "Bueno, eres maja también así, ¿eh? Eres maja.", "start": 54.0, "end": 56.1, "id": "9a3c2eec-a8ac-4834-9049-125e3b09b900"}, {"character": "Reporter", "caption": "Tranquilo. Ya está, ya la hemos cagado. ¡Hala!", "start": 56.1, "end": 58.5, "id": "e04c32e2-ee57-4059-897a-16676d2dbfbe"}, {"character": "Man", "caption": "No, no.", "start": 58.5, "end": 59.3, "id": "3939d0ab-ef66-4914-b895-64855a6b64a2"}, {"character": "Reporter", "caption": "Ya la hemos cagado. Ya la hemos cagado, eso digo yo.", "start": 59.3, "end": 101.2, "id": "bf1e3b50-4bf0-48c5-8878-9491a7f30776"}, {"character": "Reporter", "caption": "Esto... digo, ¿una canción del verano?", "start": 101.2, "end": 103.5, "id": "88fb745a-3015-40aa-b814-41bf3001b8d7"}, {"character": "Man", "caption": "Así empezó la Segunda Guerra Mundial.", "start": 108.0, "end": 110.5, "id": "b7b41727-e3ac-4633-9244-cdab10b90072"}, {"character": "Reporter", "caption": "¿Por la canción del verano?", "start": 110.5, "end": 112.0, "id": "b68c4cf6-9a18-44c4-8dc7-f5d065975c05"}, {"character": "Man", "caption": "No, no. No tengo preferencia.", "start": 112.0, "end": 114.2, "id": "106caa94-b5ba-4943-8b99-2dff6594c271"}, {"character": "Reporter", "caption": "Hombre, qué más da, cántame una. Si hay tantas, joder.", "start": 114.2, "end": 118.0, "id": "2d3a6230-0a45-4a24-bb55-53142848c85c"}, {"character": "Man", "caption": "Las Ketchup, dice ese. ¿Cuál?", "start": 118.0, "end": 120.3, "id": "8a53f850-563e-4391-b263-d47de37ec6c5"}, {"character": "Man", "caption": "Ay que te como el chichingorri... Ay que te llevo ya a comer... Ay que te como mo, ay que te como mo, ay que te como mo el chichingorri... Ay que te como el chichingorri... Ay que te llevo ya a comer... Ay que te como mo, ay que te como mo, ay que te como mo el chichingorri.", "start": 120.3, "end": 147.5, "id": "b00403a9-4902-4f75-a787-76800aeb64cb"}, {"character": "Man", "caption": "¡Aúpa! ¡Gora Euskadi askatuta! ¡Aú!", "start": 147.5, "end": 151.0, "id": "d1677d08-81d9-41a9-818c-111f3f9ad889"}, {"character": "Reporter", "caption": "Digo, ¿esta es del verano pero de qué año?", "start": 151.5, "end": 153.8, "id": "84643651-474d-4a77-94d5-d63728f66bd2"}, {"character": "Man", "caption": "De este. Esta es la primavera.", "start": 153.8, "end": 156.8, "id": "f32ca09e-558a-4a0f-b5ca-a9d1d026b6b3"}, {"character": "Reporter", "caption": "Del año...", "start": 156.8, "end": 159.0, "id": "830549a0-1934-48c2-a8cd-a31163ef7c68"}, {"character": "Reporter", "caption": "¿Y quién la canta esta?", "start": 200.0, "end": 201.8, "id": "7ac6fbf1-8d35-4140-b5c0-0f01aacdbc55"}, {"character": "Man", "caption": "Yo.", "start": 201.8, "end": 202.8, "id": "609bf32c-14f2-4496-a3fd-cdafb2afb07c"}, {"character": "Reporter", "caption": "Ah, tú, tú mismo.", "start": 202.8, "end": 204.5, "id": "1844de90-f249-4b08-9e34-81aae3505208"}, {"character": "Man", "caption": "Molto picante, molto bono. La paranza del golpe de chino, no problem, y seguro paga. Molto picante, molto bono.", "start": 204.8, "end": 211.5, "id": "57546cea-4174-45f2-ad04-e8e2dd6622ed"}, {"character": "Reporter", "caption": "Lo de que es la playa, ¿eh?", "start": 212.0, "end": 213.5, "id": "f6763bd9-fca9-4c96-bf2f-e670ed8cc04a"}, {"character": "Man", "caption": "Sí, sí.", "start": 213.5, "end": 214.5, "id": "2d85f953-e00c-4621-bae8-dbb4210b07bf"}, {"character": "Reporter", "caption": "Lo de querer coger las cosas de la playa.", "start": 214.5, "end": 215.3, "id": "aa6b4248-23a6-431c-8f0f-2dc38d4b9703"}, {"character": "Man", "caption": "No, la playa no, el cubata de ahí dentro.", "start": 215.3, "end": 217.2, "id": "44f28711-0924-4380-b217-fea3db62146a"}, {"character": "Reporter", "caption": "Bueno, pero también por culpa de la playa, ¿no?", "start": 217.2, "end": 219.0, "id": "0f36c41d-4122-4abf-8d66-427dbb6743cf"}, {"character": "Reporter", "caption": "¿Y ahora qué? ¿Un bañito o qué? ¿Para despejar o qué?", "start": 219.0, "end": 223.0, "id": "7c4397be-bb9d-489c-a393-b0270c6edb30"}, {"character": "Man", "caption": "En la majilla, ¿eh?", "start": 223.0, "end": 224.8, "id": "4abf41d7-d60e-429e-b255-ca2fa37b84ee"}, {"character": "Reporter", "caption": "Anda.", "start": 224.8, "end": 226.0, "id": "7452de1e-8b68-45b5-80ea-99c5d1a0abe6"}, {"character": "Man", "caption": "En la tele, la hostia esa que os dan, pinturas... Tienes que tener el No, está muy bien.", "start": 226.5, "end": 231.5, "id": "c74a0609-5ac6-4264-8cab-b827feeaf17e"}, {"character": "Reporter", "caption": "Como los coches.", "start": 231.5, "end": 232.8, "id": "a2e25af3-db47-45e3-83fb-a4a1ac441575"}, {"character": "Man", "caption": "Está bien. Joder, aquí hay unas surgilias... ¡uf!", "start": 232.8, "end": 236.0, "id": "12364941-a5fd-4703-ad69-b948a6f29b89"}, {"character": "Reporter", "caption": "Ah, sí, ¿o sea que tú no se liga en la playa o no?", "start": 236.0, "end": 238.2, "id": "6ddca6fc-2583-456c-8bab-1dc7f572bc72"}, {"character": "Man", "caption": "El que es tonto no.", "start": 238.2, "end": 240.0, "id": "863ca399-ca55-46dd-bef9-2fbfa9912456"}, {"character": "Reporter", "caption": "Ah.", "start": 240.0, "end": 241.0, "id": "5253bd2b-3fb1-4844-a4be-3c3cd9c467af"}, {"character": "Man", "caption": "Yo normalmente ya la edad no me lo requiere, pero de un pinitos al aire ya me he tirado.", "start": 241.8, "end": 248.0, "id": "579115bb-07c2-482b-beed-b3746c049ab7"}, {"character": "Reporter", "caption": "Sí, ¿aquí en la playa?", "start": 248.0, "end": 249.5, "id": "7452ffdd-2e99-4457-afdd-512be5fe8521"}, {"character": "Man", "caption": "En la playa, en el monte...", "start": 249.5, "end": 252.0, "id": "0c85b512-f9e6-4bd9-ae95-56599a990730"}, {"character": "Reporter", "caption": "Donde te han dejado.", "start": 252.0, "end": 253.2, "id": "f50f699d-4198-455d-a415-020ea3aab0d1"}, {"character": "Reporter", "caption": "A ti, ¿dónde te han dejado?", "start": 253.8, "end": 255.0, "id": "ce7fe905-9f6b-41ee-a5aa-d32624f0449a"}, {"character": "Reporter", "caption": "Y no te han dejado mucho, la verdad.", "start": 255.0, "end": 256.5, "id": "fb025ca6-2b6d-4b8c-914f-fdad9123ec85"}, {"character": "Man", "caption": "No, también tienes razón.", "start": 256.5, "end": 258.0, "id": "20c4034a-65f2-4931-a1e4-ef75734be47f"}, {"character": "Man", "caption": "Mucha de aquí, poca de allá.", "start": 258.5, "end": 260.0, "id": "7f578088-be2b-4ce0-9ed8-0ce9260cc8ca"}, {"character": "Man", "caption": "Oye, oye...", "start": 300.8, "end": 301.8, "id": "65404999-0871-48d8-811a-f22ffd0295b2"}, {"character": "Reporter", "caption": "Hala.", "start": 301.8, "end": 302.8, "id": "7781a4ee-8000-44f9-855d-971ff3ef90de"}, {"character": "Man", "caption": "Joder, qué maja esta chica, joder.", "start": 302.8, "end": 305.0, "id": "26d7912a-7976-4e79-b013-03ee9e892c25"}, {"character": "Reporter", "caption": "¿Ves?", "start": 305.0, "end": 305.8, "id": "41c77b58-3deb-490e-a5b4-b737aa4b3fc0"}, {"character": "Man", "caption": "A ver si todavía está esta...", "start": 305.8, "end": 308.0, "id": "1d1909bc-45c3-431b-94e3-0cdee3dc956d"}, {"character": "Man", "caption": "¡Upa! ¿Quién ha puesto esto aquí?", "start": 308.8, "end": 311.5, "id": "9733910a-e334-404e-8397-713c1f1b5fa5"}, {"character": "Reporter", "caption": "Bueno, pues a sacarlo.", "start": 311.5, "end": 313.2, "id": "8309ad59-3cd9-44bf-a9fb-3cdef9362279"}, {"character": "Man", "caption": "¿Quién ha puesto esto aquí?", "start": 313.5, "end": 315.0, "id": "b2aaa179-b9cb-4a17-9e1b-1a09e7ffd4e9"}, {"character": "Reporter", "caption": "Si es que te despistas y...", "start": 317.0, "end": 319.0, "id": "6960f098-6f89-4072-8d9a-0b96d5199ade"}], "characters": [{"name": "Man", "color": "#6c8cff"}, {"name": "Reporter", "color": "#e5636b"}], "video_url": "/uploads/4f7af330-e105-4cd1-8454-7d2f7f52485f/yt_video.mp4", "updated_at": 1786397658.472785}