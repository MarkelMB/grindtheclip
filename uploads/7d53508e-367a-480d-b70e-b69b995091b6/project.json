{"job_id": "7d53508e-367a-480d-b70e-b69b995091b6", "pack_name": "Erwin discurso", "lines": [{"id": "90ff3ede-9867-4ece-88f4-a9cf4f4bdafc", "character": "Floch Forster", "caption": "Señor, cree que vamos a morir, así es.", "start": 0.34, "end": 7.49}, {"id": "f5dd28b7-2b51-4f31-8fcd-9f7d4d39b8a1", "character": "Floch Forster", "caption": "Y como es inevitable nos pide que luchemos hasta el final.", "start": 7.49, "end": 14.77}, {"id": "c65f723b-501d-4557-ba67-483ed6f22310", "character": "Erwin Smith", "caption": "Eso es.", "start": 14.77, "end": 15.77}, {"id": "fa1bab18-3cb7-4fae-bcfa-92b30563a654", "character": "Floch Forster", "caption": "Entonces, si vamos a morir, da igual como sea, ¿no?", "start": 15.77, "end": 20.93}, {"id": "d53e1edb-7373-47d3-b9ea-321e1783e19a", "character": "Floch Forster", "caption": "Podríamos desobedecer las órdenes, porque ya no tiene sentido.", "start": 20.93, "end": 25.93}, {"id": "32e1d2ce-2d2f-495b-bb0d-3241fd19580e", "character": "Erwin Smith", "caption": "Eso es exactamente.", "start": 25.93, "end": 27.93}, {"id": "23323878-fb33-4c00-8fd6-b911682f97cc", "character": "Erwin Smith", "caption": "Ahora nada tiene sentido.", "start": 29.22, "end": 31.22}, {"id": "b365c982-c31b-4fdb-b225-2eb231994af6", "character": "Erwin Smith", "caption": "No importa en vuestros sueños o esperanzas.", "start": 31.22, "end": 34.82}, {"id": "708ed43c-d75e-43d3-809e-62ebc0f792a4", "character": "Erwin Smith", "caption": "O si vuestras vidas han sido felices y cómodas.", "start": 34.82, "end": 38.43}, {"id": "083274b2-dd85-4092-a552-a745e30404b6", "character": "Erwin Smith", "caption": "En el momento en que una roca os aplaste estaréis muertos.", "start": 38.43, "end": 42.43}, {"id": "d847b954-383e-447b-9561-ca9bb24befc2", "character": "Erwin Smith", "caption": "Significa eso que la vida no tiene ningún sentido,", "start": 42.43, "end": 48.32}, {"id": "7ade7eb3-415f-463a-93ea-99ceb6757678", "character": "Erwin Smith", "caption": "que no ha tenido sentido que nacieráis ni las muertes de vuestras compañeros", "start": 48.32, "end": 54.89}, {"id": "63e3b38b-76fe-4a8e-8bf5-a6509fce3297", "character": "Erwin Smith", "caption": "ni tampoco sus vidas, como soldados.", "start": 54.89, "end": 60.4}, {"id": "04529ebd-398e-4920-8387-ffa0e09fc03a", "character": "Erwin Smith", "caption": "Claro que no, nosotros vamos a dar sentido a su existencia", "start": 60.4, "end": 65.4}, {"id": "26bad434-af39-4921-a7e9-b5cc773ef439", "character": "Erwin Smith", "caption": "por todos los valientes que cayeron, por todos los desvalidos,", "start": 65.4, "end": 69.4}, {"id": "67f52da2-43f6-4b10-94d9-3e9ec51286ef", "character": "Erwin Smith", "caption": "los únicos que podemos recordarlos somos los vivos.", "start": 69.4, "end": 73.4}, {"id": "7e76d455-f722-4535-a37f-582214da8d0a", "character": "Erwin Smith", "caption": "Hoy vamos a morir aquí, dejando el sentido de nuestras vidas", "start": 73.4, "end": 77.4}, {"id": "5a8a44b2-ee62-4974-8e1b-c858a5a26cc5", "character": "Erwin Smith", "caption": "en manos de los que nos sucederán.", "start": 77.4, "end": 80.5}, {"id": "abf1cdf5-2e7f-4676-b8fc-cb59d6b70688", "character": "Erwin Smith", "caption": "Sólo así podemos revelarnos contra este mundo tan cruel.", "start": 80.5, "end": 84.5}, {"id": "fcab3635-a48d-453e-8cfa-99f43b379306", "character": "Erwin Smith", "caption": "¡Drabias soldados! ¡Viritas soldados! ¡Lujas soldados!", "start": 84.5, "end": 91.5}], "characters": [{"name": "Erwin Smith", "color": "#6c8cff"}, {"name": "Floch Forster", "color": "#e5636b"}], "video_url": "/uploads/7d53508e-367a-480d-b70e-b69b995091b6/yt_video.mp4", "updated_at": 1785793030.2635348}