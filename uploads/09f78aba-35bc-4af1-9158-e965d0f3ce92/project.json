{"job_id": "09f78aba-35bc-4af1-9158-e965d0f3ce92", "pack_name": "dexter contenedores", "lines": [{"character": "Dexter", "caption": "Bueno, Deb. Que sigas viva.", "start": 10.5, "end": 14.5, "id": "72526ed0-6d06-4ec7-99d1-7a75164379b5"}, {"character": "Dexter", "caption": "Joder.", "start": 20.0, "end": 21.0, "id": "770f0d43-16c0-4d28-a19e-37279baeb9da"}, {"character": "Doakes", "caption": "¡Sorpresa, hijo de puta!", "start": 22.5, "end": 24.8, "id": "bef66be7-f823-4331-96bf-88e203924297"}, {"character": "Dexter", "caption": "¿Me estás siguiendo?", "start": 25.8, "end": 27.0, "id": "6b2a1d97-09cb-453f-904c-4c0adcba1b71"}, {"character": "Doakes", "caption": "Espero que puedas explicar qué haces aquí.", "start": 27.2, "end": 29.1, "id": "3a29247e-40e1-45ed-997a-d9fe524166a1"}, {"character": "Dexter", "caption": "Buscando a mi hermana.", "start": 29.2, "end": 30.4, "id": "9d027209-6288-4749-b1fc-a797cc409622"}, {"character": "Doakes", "caption": "¿En un contenedor?", "start": 30.5, "end": 31.4, "id": "34196bc5-6eec-4318-b264-b92d19438e22"}, {"character": "Dexter", "caption": "Sí. Trabajo en una teoría.", "start": 31.5, "end": 33.3, "id": "a2c08ae6-c2d0-432b-805f-8f2e697a44a1"}, {"character": "Doakes", "caption": "¿Olvidas que trabajas para la poli? ¿Qué teoría? Cuéntamela, gilipollas.", "start": 33.8, "end": 37.0, "id": "96422a06-803b-49a6-b755-48fa86b1e173"}, {"character": "Dexter", "caption": "Estoy en mi tiempo libre. Es asunto mío.", "start": 37.0, "end": 39.1, "id": "06409d91-402d-4885-9301-4485379474e7"}, {"character": "Doakes", "caption": "Sí, yo también estoy en mi tiempo libre.", "start": 39.2, "end": 41.0, "id": "5acbc5cb-eb76-4b12-b408-4d6eea0b1ce9"}, {"character": "Doakes", "caption": "Y ahora ninguna teniente te protege, así que no me jodas, Morgan.", "start": 41.2, "end": 44.2, "id": "23dc6e77-ce55-46c4-9234-8aeaf2eaf08e"}, {"character": "Dexter", "caption": "Vale, me has pillado.", "start": 44.3, "end": 46.0, "id": "496e068f-153c-4401-bb77-e6a1254bdc55"}, {"character": "Dexter", "caption": "He comprado unos muebles de Tailandia y los estaba esperando.", "start": 47.3, "end": 50.0, "id": "41b95a14-d726-41bd-97c4-54f7b87dc2db"}, {"character": "Doakes", "caption": "Rata de laboratorio.", "start": 58.5, "end": 100.0, "id": "79b66576-e824-47b4-b3b5-2fde68dd8800"}, {"character": "Guardia", "caption": "¿Qué diablos está pasando aquí? Seguridad, manden a alguien inmediatamente.", "start": 102.8, "end": 106.5, "id": "92300990-2791-4bff-92e1-9230e2014f23"}, {"character": "Doakes", "caption": "Policía de Miami.", "start": 106.9, "end": 108.0, "id": "fe58404b-57a1-4381-808a-25d7ba97e755"}, {"character": "Guardia", "caption": "Sí. ¿Está arrestando a este hombre?", "start": 108.1, "end": 109.3, "id": "aa687a03-5330-458b-a2c5-43b0799eb62f"}, {"character": "Dexter", "caption": "Buena pregunta.", "start": 109.3, "end": 110.3, "id": "ea47a086-029a-4719-950b-c87d5f894811"}, {"character": "Doakes", "caption": "Tienes algo que ver con esto. No sé cómo, pero voy a descubrirlo y se te va a caer el pelo, cabrón.", "start": 111.0, "end": 116.8, "id": "4d2202fd-ea0c-4aae-9699-ff5d7f97d616"}], "characters": [{"name": "Dexter", "color": "#6c8cff"}, {"name": "Doakes", "color": "#e5636b"}, {"name": "Guardia", "color": "#4caf7d"}], "video_url": "/uploads/09f78aba-35bc-4af1-9158-e965d0f3ce92/source.mp4", "updated_at": 1786649419.0390272}