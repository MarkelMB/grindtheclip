{"job_id": "a7d35b4a-0632-478c-946d-2e7aab2341f8", "pack_name": "gombal", "lines": [{"id": "20dadae9-db64-4284-9017-2f9be8e56260", "character": "Man", "caption": "Cada jornada es un círculo que se vuelve cuadrado.", "start": 0.0, "end": 3.5}, {"id": "02ef84fc-6b17-4686-865f-361b4753ac16", "character": "Man", "caption": "Pero no puedes cuadrar el círculo.", "start": 3.8, "end": 6.5}, {"id": "318351bf-92cd-42b6-bb7b-d29d6b20ca24", "character": "Man", "caption": "Solo puedes correr.", "start": 6.8, "end": 8.8}, {"id": "a0b33352-beb8-4c44-b953-ef2ef1a4c5f7", "character": "Man", "caption": "Correr hacia ti,", "start": 8.9, "end": 10.8}, {"id": "69e7cc87-0bfd-464b-a60b-d06c2e185edd", "character": "Man", "caption": "hacia mí,", "start": 11.2, "end": 12.8}, {"id": "38436984-250d-4ea8-8781-5d7b403d7b21", "character": "Man", "caption": "hacia nosotros,", "start": 13.2, "end": 14.8}, {"id": "cbc998ed-9a09-46f2-9670-06e5bc0c4ff7", "character": "Man", "caption": "hacia afuera de todo,", "start": 15.0, "end": 17.3}, {"id": "fa2543c5-d914-40bb-8997-39e67c8d0f14", "character": "Man", "caption": "adentro de la nada.", "start": 17.8, "end": 20.0}, {"id": "3a5f3032-46a0-4e7f-b0a9-83380141b5c8", "character": "Man", "caption": "En fin e eternidad o...", "start": 20.5, "end": 23.3}, {"id": "b57d23a4-9e9d-41a7-a5d6-164d8cb138c2", "character": "Man", "caption": "¡Okay, okay! ¡Ya puedes saltar el video! ¡Qué prisa!", "start": 23.7, "end": 26.5}, {"id": "c706e934-5f69-4460-9219-0d79df91cf44", "character": "Richard", "caption": "Hola, esta semana reseñaré un juego que forma parte de mi computadora.", "start": 27.2, "end": 30.2}, {"id": "e84b14ac-c60e-4213-bfd9-41868e88f655", "character": "Richard", "caption": "No es tan bueno como Buscaminas o Solitario, pero vale la pena.", "start": 30.8, "end": 36.0}, {"id": "966029f3-d3c8-4266-a724-675be3fe607e", "character": "Richard", "caption": "Okay, ahora yo voy a cargar el juego.", "start": 36.5, "end": 39.0}, {"id": "b5bccb0d-521c-48fb-81c0-bc67309b5be9", "character": "Richard", "caption": "Bien, se llama Calculadora.", "start": 40.5, "end": 43.0}, {"id": "6cd964e5-7acd-4aa8-b0ef-240c0f24335f", "character": "Richard", "caption": "Eliges a tu personaje y tomas un par de binoculares.", "start": 43.8, "end": 47.2}, {"id": "3b1e3944-a65b-41e5-9bc0-43772d1c875b", "character": "Richard", "caption": "Tienes que encontrar el tesoro marcado con una X, obviamente.", "start": 47.5, "end": 51.5}, {"id": "26e1aa4d-afa6-44ee-ae10-a9fb27c3ca9d", "character": "Richard", "caption": "Pero ten cuidado, porque cuando llegas al tesoro hay una serpiente.", "start": 52.0, "end": 56.0}, {"id": "93409d70-d4fd-4d14-b725-d28a2290f682", "character": "Richard", "caption": "Pero", "start": 56.5, "end": 59.39}, {"id": "909b384c-71d4-4bb6-a219-ebcfbc4f1a6f", "character": "Richard", "caption": "está", "start": 59.39, "end": 62.28}, {"id": "7fe5d05c-f4de-4976-91b9-944632351a61", "character": "Richard", "caption": "bien", "start": 62.28, "end": 65.17}, {"id": "1f5e8d50-2bee-4b2b-b873-ad8dc521e0a3", "character": "Richard", "caption": "porque", "start": 65.17, "end": 69.5}, {"id": "012840f1-65b0-49ff-b293-5f8598ff6fc6", "character": "Richard", "caption": "puedes", "start": 69.5, "end": 73.83}, {"id": "a12e9155-9ef8-4cfd-999f-dfc01c0cc6b5", "character": "Richard", "caption": "tomar", "start": 73.83, "end": 77.44}, {"id": "d82d5f01-30a5-4eb3-bb13-511e62ffd907", "character": "Richard", "caption": "un", "start": 77.44, "end": 78.88}, {"id": "850244fd-c318-4b67-aca5-52ffe73d3fa4", "character": "Richard", "caption": "hacha", "start": 78.88, "end": 82.49}, {"id": "2b7ef8e7-4e7d-44fc-bcd5-e1f3d61684bf", "character": "Richard", "caption": "o", "start": 82.49, "end": 83.21}, {"id": "20735d33-2091-40b2-9298-ec84f7a0c7be", "character": "Richard", "caption": "un", "start": 83.21, "end": 84.65}, {"id": "21bd7589-9797-49bf-be94-e1662d0330f8", "character": "Richard", "caption": "arco", "start": 84.65, "end": 87.54}, {"id": "96ebbe01-539a-4314-89e3-9c8b9ffee0af", "character": "Richard", "caption": "y", "start": 87.54, "end": 88.26}, {"id": "976ac9e3-a0b5-4b58-803d-58eee1d9d500", "character": "Richard", "caption": "la", "start": 88.26, "end": 89.7}, {"id": "758328d9-ce46-4b53-a8a6-6c50b3278d80", "character": "Richard", "caption": "flecha", "start": 89.7, "end": 94.03}, {"id": "610c9b3f-2384-4fdc-a788-893d4b1b04f6", "character": "Richard", "caption": "y", "start": 94.03, "end": 94.75}, {"id": "ae4e82dc-9fde-4128-928a-bb48c8d430c8", "character": "Richard", "caption": "matarla.", "start": 94.75, "end": 100.52}, {"id": "9e405ec6-74bc-486d-b7fd-6006f551784d", "character": "Richard", "caption": "Luego ve cuánto hiciste.", "start": 101.0, "end": 103.0}, {"id": "6d25d657-6df4-4c31-bbba-f58eb39c86f6", "character": "Richard", "caption": "¡Oigan, tengo un marcador muy alto!", "start": 103.2, "end": 105.5}, {"id": "8ecafe16-2285-433c-9500-57a45d92e03d", "character": "Richard", "caption": "Una crítica que tengo es que no hay personajes femeninos, pero no hay masculinos tampoco, así que está bien.", "start": 106.5, "end": 112.2}, {"id": "25cc23db-95ed-4667-886b-30ebcca12f7c", "character": "Richard", "caption": "Hay un par de errores con ciertos comandos,", "start": 113.0, "end": 116.8}, {"id": "6edac9cc-33ea-45d8-bf6e-0f6eb573cea1", "character": "Richard", "caption": "como cuando quieres usar el arco y el globo, vean lo que pasa.", "start": 116.8, "end": 120.5}, {"id": "e58f4d4c-dbf5-41aa-a86f-04e6b4eb9f95", "character": "Richard", "caption": "Es un buen juego, 8 de 10, lo jugaría otra vez.", "start": 123.0, "end": 125.5}, {"id": "d53b6eea-3f29-438f-bb40-39452786f4d5", "character": "Gumball", "caption": "¡Gorila contra ballena asesina!", "start": 126.5, "end": 128.8}, {"id": "67adb343-5080-4d85-ace2-e37e0c0777a8", "character": "Darwin", "caption": "¡Ah, engaño!", "start": 133.0, "end": 134.5}, {"id": "f1c9d539-cde9-4478-9956-49594899d62c", "character": "Tobias", "caption": "Hola, soy Tobias Wilson y esta broma se llama '¡Ya levántate!'", "start": 136.0, "end": 140.2}, {"id": "00e8ce23-9cbf-4e17-a574-eba28c7be0e9", "character": "Tobias", "caption": "[screams] ¡Waaah! ¡Sí!", "start": 140.8, "end": 144.2}, {"id": "a19baed8-d53c-4f74-b41a-5d684a7c559e", "character": "Tobias", "caption": "De acuerdo, son las 5:00 a. m. y mi papá se va a levantar para ir a trabajar,", "start": 145.0, "end": 149.0}, {"id": "e4d5f196-2163-4646-945e-f7331159dfc8", "character": "Tobias", "caption": "pero puse mi patineta bajando las escaleras.", "start": 149.2, "end": 152.5}, {"id": "0fe3a718-02d9-4724-8f10-766422fe44b5", "character": "Tobias", "caption": "¡Shh! Vamos a ver qué pasa.", "start": 153.0, "end": 156.0}, {"id": "bc91af82-7b1b-48af-86e0-b59d8a29ce9f", "character": "Tobias' Dad", "caption": "¡Pero qué--!", "start": 157.2, "end": 158.8}, {"id": "eaccd0f2-98e7-4b3b-aa80-63ca093bd83a", "character": "Tobias' Dad", "caption": "¡Nena! ¡Nos están robando!", "start": 159.0, "end": 161.0}, {"id": "bcd18746-7a9a-4f12-a77e-02f207e488b4", "character": "Tobias' Mom", "caption": "[screams] ¡Aaaah!", "start": 161.0, "end": 162.5}, {"id": "724961c8-3dc9-4f74-a37a-3a3c2a2f9cde", "character": "Tobias' Dad", "caption": "¡Policía, tenemos un intruso! ¡Sí!", "start": 162.0, "end": 164.2}, {"id": "4c7fc9e6-8a66-41d2-b4c8-a1c2b993cf2c", "character": "Tobias' Dad", "caption": "Está armado y es peligroso, usa gorra de rapero.", "start": 164.3, "end": 167.0}, {"id": "71db6f5d-6bdd-4164-8c00-9b88eb111b62", "character": "Tobias", "caption": "¡Soy yo! ¡Es una broma! Cayeron ante Tobias.", "start": 167.0, "end": 172.2}, {"id": "c158d0f7-5b35-4291-9c98-0fde3f80e369", "character": "Tobias' Dad", "caption": "Por supuesto, pues de repente este horrible acto se vuelve divertido.", "start": 173.0, "end": 177.2}, {"id": "aa2b27a5-c0d6-4d4c-98fb-87b9b341b88b", "character": "Tobias' Dad", "caption": "[laughs] ¡Creí que mi familia estaba en peligro mortal, pero no era así!", "start": 177.5, "end": 183.2}, {"id": "6839658c-1077-4201-a861-532266639bfb", "character": "Tobias' Dad", "caption": "¡Estás castigado!", "start": 183.5, "end": 185.0}, {"id": "0332b23f-3aea-4e8f-bac5-ddfc4314b820", "character": "Tobias", "caption": "Esta fue una broma extrema con Tobias Wilson.", "start": 185.5, "end": 188.0}, {"id": "80e4a6db-1842-4885-ba17-ae53a7d77874", "character": "Gumball", "caption": "¿Qué? ¿El corto de cine de El increíble mundo de Gumball? ¡Dale clic!", "start": 190.5, "end": 194.8}, {"id": "cbdc7523-aa15-49ee-a201-800e26134650", "character": "Announcer", "caption": "Este corto ha sido autorizado para todo el público por la Asociación Cinematográfica de Elmore.", "start": 196.5, "end": 200.0}, {"id": "d6eafe4e-ec2c-4d81-b08a-e85fb8055cb5", "character": "Gumball", "caption": "¡No!", "start": 201.0, "end": 202.2}, {"id": "93a31d7a-7a93-4cd9-8d0b-4842e8e05486", "character": "Announcer", "caption": "Un pequeño momento de calma.", "start": 204.8, "end": 206.8}, {"id": "eab97727-5b3d-4d63-b037-e7d345184b8c", "character": "Mr. Small", "caption": "Bienvenidos al pequeño momento de calma conmigo, el Señor Small.", "start": 207.0, "end": 211.8}, {"id": "824f1f17-8bcd-491e-a11a-db2084bc0a94", "character": "Mr. Small", "caption": "Debí haberlo llamado 'Pequeño momento de calma'.", "start": 212.0, "end": 214.2}, {"id": "b82e5241-341b-4418-83a7-8d9c891b91cd", "character": "Mr. Small", "caption": "Como sea, liberen sus chakras.", "start": 214.5, "end": 216.8}, {"id": "a0ddb4f3-b19d-44ed-bb55-8bcbfde7f693", "character": "Mr. Small", "caption": "Se los demostraré usando mi nuevo disco, ahora disponible en estaciones de gas y supermercados en rebajas.", "start": 217.0, "end": 223.0}, {"id": "29489551-9695-4ffa-b41a-1c86e626b813", "character": "Mr. Small", "caption": "Abran su pecho y relájense.", "start": 224.0, "end": 227.8}, {"id": "a6983d48-346f-4f22-a333-1b0e27ad4b31", "character": "Mr. Small", "caption": "Inhalen, exhalen.", "start": 228.5, "end": 231.5}, {"id": "e1a2edf9-67cf-47a4-8a63-d3cd5cf3ac51", "character": "Mr. Small", "caption": "Inhalen, exhalen.", "start": 232.0, "end": 235.0}, {"id": "d77c0763-b59e-4879-bd8b-72ce0f2a0a91", "character": "Mr. Small", "caption": "Exhalen, exhalen, exhalen.", "start": 235.5, "end": 240.0}, {"id": "8443c26b-2673-4875-bf3c-2618ea895f58", "character": "Mr. Small", "caption": "Exhalen, exhalen, exhalen.", "start": 240.5, "end": 245.0}, {"id": "30f62459-cdc7-4ffb-850d-2f0f108774b4", "character": "Mr. Small", "caption": "Exhalen, exhalen, exhalen.", "start": 245.5, "end": 249.13}], "characters": [{"name": "Announcer", "color": "#6c8cff"}, {"name": "Darwin", "color": "#e5636b"}, {"name": "Gumball", "color": "#4caf7d"}, {"name": "Man", "color": "#d9a441"}, {"name": "Mr. Small", "color": "#c471ed"}, {"name": "Richard", "color": "#41c7d9"}, {"name": "Tobias", "color": "#f27b9b"}, {"name": "Tobias' Dad", "color": "#8bc34a"}, {"name": "Tobias' Mom", "color": "#6c8cff"}], "video_url": "/uploads/a7d35b4a-0632-478c-946d-2e7aab2341f8/yt_video.mp4", "updated_at": 1787523559.4977758}