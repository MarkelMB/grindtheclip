{"job_id": "fd48804d-aa59-48e2-b95c-9c9c745d35a9", "pack_name": "piensa mark", "lines": [{"character": "Omni-Man", "caption": "[grunts]", "start": 0.0, "end": 4.15, "id": "929759aa-0cd0-4a22-aafa-79764cd35491"}, {"character": "Omni-Man", "caption": "¡Mierda!", "start": 3.45, "end": 5.45, "id": "f026b088-bf2d-4386-99fc-677e390701fe"}, {"character": "Omni-Man", "caption": "[panting]", "start": 10.45, "end": 16.85, "id": "8dbec8c2-6fe9-4e3c-94d3-7412a562c84f"}, {"character": "Mark", "caption": "[groaning]", "start": 17.45, "end": 22.85, "id": "dc003474-4546-406d-9050-659d0bf87b52"}, {"character": "Omni-Man", "caption": "[sighs]", "start": 25.95, "end": 29.35, "id": "fcf2e5f0-5670-4e0b-8299-e27fde5e854b"}, {"character": "Omni-Man", "caption": "¿Por qué me obligas a hacer esto?", "start": 29.75, "end": 32.75, "id": "2dfda32f-0bf7-4543-9f29-dd03c8fbd7c9"}, {"character": "Omni-Man", "caption": "¡Solo luchas para poder ver morir a todos los que te rodean!", "start": 32.45, "end": 36.65, "id": "2eff111f-8386-4c9b-8a48-b3ec4bd9c925"}, {"character": "Omni-Man", "caption": "¡Piensa, Mark! Vivirás más que todos los seres frágiles e insignificantes de este planeta.", "start": 35.95, "end": 41.55, "id": "f65c7043-b97c-40bf-a429-5f55f91fa1f1"}, {"character": "Omni-Man", "caption": "Vivirás para ver cómo este mundo se reduce a polvo y se dispersa.", "start": 41.35, "end": 47.15, "id": "d2799c24-0e05-4570-ab93-a48684a34c4d"}, {"character": "Omni-Man", "caption": "¡Todas las cosas y todas las personas que conoces desaparecerán!", "start": 46.65, "end": 52.15, "id": "bcaf43c3-d138-4d83-947a-6647ed280000"}, {"character": "Omni-Man", "caption": "¿Qué te quedará cuando hayan pasado 500 años?", "start": 54.65, "end": 60.15, "id": "ee1b007f-14da-4e13-92ba-943501b7d218"}, {"character": "Mark", "caption": "Tú, papá... Me quedarías tú...", "start": 100.85, "end": 107.15, "id": "ed66919f-a0fa-4eda-8bb6-c95fa7db1b89"}, {"character": "Omni-Man", "caption": "[panting]", "start": 113.85, "end": 118.85, "id": "3a5ee7a0-301c-44d4-8f58-fa93e1a3cb00"}, {"character": "Mark", "caption": "Papá...", "start": 122.45, "end": 124.35, "id": "4509e0c4-9f04-48cd-a17a-271e388fb63f"}, {"character": "Omni-Man", "caption": "[groans]", "start": 124.65, "end": 130.55, "id": "1d49b27c-470d-46dc-b3f9-b1115b3dfe38"}], "characters": [{"name": "Mark", "color": "#6c8cff"}, {"name": "Omni-Man", "color": "#e5636b"}], "video_url": "/uploads/fd48804d-aa59-48e2-b95c-9c9c745d35a9/yt_video.mp4", "updated_at": 1787515062.9386513}