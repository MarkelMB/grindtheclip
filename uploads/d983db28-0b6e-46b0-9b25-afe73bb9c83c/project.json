{"job_id": "d983db28-0b6e-46b0-9b25-afe73bb9c83c", "pack_name": "un bestia y un bruto", "lines": [{"id": "7ff04ead-78b4-4cda-b144-292ed842dcf2", "character": "Man", "caption": "Yo también me despido.", "start": 0.0, "end": 2.2}, {"id": "cb42c408-ff39-459b-96bc-f3ff088514f3", "character": "Woman", "caption": "¿Y cómo vuelvo yo a la casa?", "start": 6.5, "end": 8.1}, {"id": "e43ae01d-d804-443c-8402-598cc59c2ba3", "character": "Woman", "caption": "Déjame subir en la moto.", "start": 21.7, "end": 23.1}, {"id": "296e80d1-a955-48c7-ad8b-34fc8b353fb6", "character": "Man", "caption": "¿Cómo?", "start": 23.15, "end": 23.7}, {"id": "d55d12bf-b15a-49f7-b962-d84ccf3b5656", "character": "Woman", "caption": "Que me dejes subir en la moto.", "start": 24.0, "end": 25.8}, {"id": "d465e150-13a0-414d-9aeb-625a88674064", "character": "Man", "caption": "A ver, dices que soy un bestia y un bruto, ¿no?", "start": 26.5, "end": 29.1}, {"id": "a6048053-d38e-4fcb-8b8f-10a517e3e06b", "character": "Man", "caption": "Yo no puedo permitir que alguien así te lleve a casa.", "start": 30.2, "end": 33.1}, {"id": "3e98807f-4eba-411e-9e34-5e557a9564e2", "character": "Man", "caption": "Y lo hago por ti, ¿eh?", "start": 33.2, "end": 35.0}, {"id": "0c3d2325-b72a-4f58-acf1-7dc893a328f5", "character": "Man", "caption": "Mañana te arrepentirás de no haber sido coherente.", "start": 35.2, "end": 37.5}, {"id": "4393b432-4ceb-47ed-b87c-e45b67dab71f", "character": "Woman", "caption": "¡Pare, por favor!", "start": 41.0, "end": 42.3}, {"id": "b01797c7-98a4-4d92-a56c-4a022e9f0ebc", "character": "Driver", "caption": "¿Quieres que te lleve a algún sitio, bonita?", "start": 42.4, "end": 44.1}, {"id": "71b20b26-358a-473e-b3af-a9cae418a8f9", "character": "Man", "caption": "¿Y tú quieres que te pegue un guantazo, gilipollas?", "start": 44.1, "end": 46.1}, {"id": "ae655b0f-e021-4f8d-8c7b-93a4ad576765", "character": "Man", "caption": "Mira, tira.", "start": 46.2, "end": 47.0}, {"id": "cb4652ae-c2df-4a4e-a7b2-017ce1b80cdb", "character": "Man", "caption": "¡Tira!", "start": 47.1, "end": 48.0}, {"id": "b0fe95ca-40d8-43c3-a9a2-6649b9bb83f3", "character": "Man", "caption": "Súbete, anda, que ya me he peleado con bastante gente esta noche por tu culpa, sube.", "start": 55.5, "end": 58.2}], "characters": [{"name": "Driver", "color": "#6c8cff"}, {"name": "Man", "color": "#e5636b"}, {"name": "Woman", "color": "#4caf7d"}], "video_url": "/uploads/d983db28-0b6e-46b0-9b25-afe73bb9c83c/yt_video.mp4", "updated_at": 1787698247.4657571}